# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/aivalon

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Local env / secrets
.env

# Local SQLite database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# User-uploaded character/lorebook images — local data, not source
/web/static/uploads/

.examples

# Local release build artifacts — everything in /dist/ is ignored except
# the current release's own AIvalon archives, which ARE committed and
# served straight off the repo via raw.githubusercontent.com (pinned to
# the release tag), so the installers don't depend on GitHub Release
# upload timing.
/dist/*
!/dist/aivalon-linux-x64.tar.gz
!/dist/aivalon-windows-x64.zip