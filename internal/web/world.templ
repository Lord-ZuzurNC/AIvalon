package web

import (
	"fmt"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

templ WorldPage(books []db.Lorebook) {
	@Layout("World", "World") {
		@PageHeaderWithViewAndCreate("World", "world", "lorebook-import-modal", "lorebook-modal", "Add a lorebook")
		<p>Lorebooks: world info the narrator can draw on. Attach one to a session in Chat.</p>
		if len(books) == 0 {
			<p><em>No lorebooks yet — add one above, then open it to add entries.</em></p>
		} else {
			<div data-view-panel="grid" class="card-grid">
				for _, b := range books {
					@vignetteCard(fmt.Sprintf("/world/%d", b.ID), b.ImagePath, b.Name, fmt.Sprintf("/world/%d/delete", b.ID))
				}
			</div>
			<div data-view-panel="list" hidden="hidden">
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Entries</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, b := range books {
							<tr>
								<td>@Avatar(b.ImagePath, b.Name)<a href={ templ.URL(fmt.Sprintf("/world/%d", b.ID)) }>{ b.Name }</a></td>
								<td>{ fmt.Sprintf("%d", b.EntryCount) }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-lorebook-%d", b.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/world/%d/delete", b.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@viewToggleScript()
		}

		<dialog id="lorebook-modal">
			<article>
				<header>
					<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
					<strong>Add a lorebook</strong>
				</header>
				<form method="post" action="/world" enctype="multipart/form-data">
					<label>
						Name
						<input type="text" name="name" required="required"/>
					</label>
					@ImageField("", "")
					<button type="submit">Add lorebook</button>
				</form>
			</article>
		</dialog>
		@ImportModal("lorebook-import-modal", "/world/import")
		@tabsScript()
	}
}

templ LorebookPage(book db.Lorebook, entries []db.LorebookEntry, editingEntry *db.LorebookEntry) {
	@Layout(book.Name, "World") {
		@BackLink("/world", "World")
		<h1>{ book.Name }</h1>
		<p class="entry-count-sub">{ entryCountLabel(len(entries)) }</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/world/%d", book.ID)) } enctype="multipart/form-data">
			<label>
				Name
				<input type="text" name="name" value={ book.Name } required="required"/>
			</label>
			@ImageField(book.ImagePath, book.Name)
			<button type="submit">Rename</button>
		</form>

		<h2>Entries</h2>
		if len(entries) == 0 {
			<p><em>No entries yet — add one below.</em></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Keys</th>
						<th>Trigger</th>
						<th>Order</th>
						<th>Probability</th>
						<th>Enabled</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, e := range entries {
						<tr>
							<td>@lorebookKeysCell(book.ID, e.ID, e.Keys)</td>
							<td>{ e.TriggerStrategy }</td>
							<td>{ fmt.Sprintf("%d", e.InsertionOrder) }</td>
							<td>{ fmt.Sprintf("%d", e.Probability) }</td>
							<td>
								<form method="post" action={ templ.URL(fmt.Sprintf("/world/%d/entries/%d/toggle", book.ID, e.ID)) } class="enabled-toggle">
									if e.Enabled {
										<button type="submit" aria-label="Disable this entry" title="Disable this entry">✅</button>
									} else {
										<button type="submit" aria-label="Enable this entry" title="Enable this entry">❌</button>
									}
								</form>
							</td>
							<td>
								@OptionsMenu(fmt.Sprintf("options-entry-%d", e.ID), []MenuAction{
									{Label: "Delete", Action: fmt.Sprintf("/world/%d/entries/%d/delete", book.ID, e.ID), Danger: true},
								})
							</td>
						</tr>
					}
				</tbody>
			</table>
			@lorebookKeysScript()
		}

		<button type="button" class="create-button" aria-label="Add an entry" title="Add an entry" onclick="document.getElementById('entry-modal').setAttribute('open','')">+</button>

		<dialog id="entry-modal" open?={ editingEntry != nil }>
			<article>
				<header>
					<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
					<strong>
						if editingEntry != nil {
							Edit entry
						} else {
							Add an entry
						}
					</strong>
				</header>
				@lorebookEntryForm(book, editingEntry)
			</article>
		</dialog>
	}
}

// lorebookKeysCell shows an entry's trigger keys plus a count badge
// (Lord's ask — an imported card's lorebook can carry dozens of keys
// per entry, no way to size that at a glance before this). Two or
// fewer keys just render in full, same as before; past that, only
// the first two show plus a "▾ N keys" toggle above AND a mirrored
// "▴ Collapse" below the now-expanded list — so collapsing a long
// list back down doesn't mean scrolling back up to find the control
// that opened it. The <a> still goes straight to editing the entry;
// the toggles are separate siblings, not nested inside it, so they
// don't also trigger that navigation.
templ lorebookKeysCell(bookID, entryID int64, keys []string) {
	{{ editHref := templ.URL(fmt.Sprintf("/world/%d/entries/%d/edit", bookID, entryID)) }}
	if len(keys) <= 2 {
		<a href={ editHref }>{ joinKeys(keys) }</a>
	} else {
		{{ preview := joinKeys(previewKeys(keys, 2)) + "…" }}
		{{ full := joinKeys(keys) }}
		<div class="keys-cell">
			<button type="button" class="keys-toggle" aria-label="Show all keys" data-expand-label={ "▾ " + keyCountLabel(len(keys)) } data-collapse-label="▴ Collapse" onclick="toggleLorebookKeys(this)">{ "▾ " + keyCountLabel(len(keys)) }</button>
			<a href={ editHref } class="keys-list" data-preview={ preview } data-full={ full }>{ preview }</a>
			<button type="button" class="keys-toggle keys-toggle-bottom" hidden aria-label="Collapse keys" onclick="toggleLorebookKeys(this)">▴ Collapse</button>
		</div>
	}
}

// lorebookKeysScript drives lorebookKeysCell's expand/collapse — both
// toggles in a cell (top and bottom) flip the same state together, so
// either one works regardless of how far the user scrolled. State
// lives in the bottom toggle's own hidden attribute (visible = "the
// list below is expanded") rather than being re-derived from text
// content, so a label with "…" or odd characters in it can't confuse
// the check.
templ lorebookKeysScript() {
	<script>
		function toggleLorebookKeys(btn) {
			var cell = btn.closest(".keys-cell");
			var top = cell.querySelector(".keys-toggle:not(.keys-toggle-bottom)");
			var bottom = cell.querySelector(".keys-toggle-bottom");
			var link = cell.querySelector(".keys-list");
			var expanding = bottom.hidden;
			link.textContent = expanding ? link.dataset.full : link.dataset.preview;
			top.textContent = expanding ? top.dataset.collapseLabel : top.dataset.expandLabel;
			bottom.hidden = !expanding;
		}
	</script>
}

templ lorebookEntryForm(book db.Lorebook, editing *db.LorebookEntry) {
	{{
	action := fmt.Sprintf("/world/%d/entries", book.ID)
	keys, content, triggerStrategy := "", "", "selective"
	insertionOrder, probability := "0", "100"
	enabled := true
	if editing != nil {
		action = fmt.Sprintf("/world/%d/entries/%d", book.ID, editing.ID)
		keys = joinKeys(editing.Keys)
		content = editing.Content
		triggerStrategy = editing.TriggerStrategy
		insertionOrder = fmt.Sprintf("%d", editing.InsertionOrder)
		probability = fmt.Sprintf("%d", editing.Probability)
		enabled = editing.Enabled
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<label>
			Keys (comma-separated — ignored if trigger is "constant")
			<input type="text" name="keys" value={ keys } placeholder="tower, arcane tomes"/>
		</label>
		<label>
			Content
			<textarea name="content" required="required">{ content }</textarea>
		</label>
		<label>
			Trigger
			<select name="trigger_strategy">
				<option value="selective" selected?={ triggerStrategy == "selective" }>selective (matches a key)</option>
				<option value="constant" selected?={ triggerStrategy == "constant" }>constant (always active)</option>
			</select>
			<small>When this entry's content gets shown to the narrator. "Constant" = every single message, no matter what you write. "Selective" = only when one of the Keys above appears as a whole word in your last message (e.g. key "dragon" only fires if you actually typed "dragon").</small>
		</label>
		<label>
			Insertion order
			<input type="number" name="insertion_order" value={ insertionOrder }/>
			<small>Only matters when several entries fire on the same message: lower number goes first in what the narrator reads. Leave at 0 unless you have entries that need a specific order relative to each other.</small>
		</label>
		<label>
			Probability (0-100)
			<input type="number" name="probability" value={ probability } min="0" max="100"/>
			<small>Even when this entry would fire (constant, or its key matched), only include it this % of the time — a dice roll on top of the trigger. 100 = always, no randomness. Leave at 100 unless you deliberately want this fact to show up inconsistently.</small>
		</label>
		<label>
			<input type="checkbox" name="enabled" checked?={ enabled }/>
			Enabled
			<small>Switches this entry off without deleting it — handy for a fact that's temporarily outdated or spoils something, since you keep the text saved to re-enable later.</small>
		</label>
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add entry
			}
		</button>
	</form>
}
