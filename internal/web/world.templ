package web

import (
	"fmt"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
	"github.com/Lord-ZuzurNC/AIvalon/internal/i18n"
)

templ WorldPage(books []db.Lorebook, pager Pager) {
	@Layout(i18n.T(ctx, "world.title"), "worlds") {
		@PageHeaderWithViewAndCreate(i18n.T(ctx, "world.title"), "world", "lorebook-import-modal", "lorebook-modal", i18n.T(ctx, "world.add"))
		<p>{ i18n.T(ctx, "world.intro") }</p>
		if len(books) == 0 {
			<p><em>{ i18n.T(ctx, "world.empty") }</em></p>
		} else {
			@searchFilterInput("world")
			<div data-search-scope="world">
				<div data-view-panel="grid" class="card-grid">
					for _, b := range books {
						@vignetteCard(fmt.Sprintf("/world/%d", b.ID), b.ImagePath, b.Name, fmt.Sprintf("/world/%d/delete", b.ID), fmt.Sprintf("/vault/worlds/%d/in", b.ID), b.ChatCount-b.VaultedChatCount, b.VaultedChatCount)
					}
				</div>
				<div data-view-panel="list" hidden="hidden">
				<table>
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "world.col_name") }</th>
							<th>{ i18n.T(ctx, "world.col_chats") }</th>
							<th>{ i18n.T(ctx, "world.col_entries") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, b := range books {
							<tr data-search-name={ b.Name }>
								<td>@Avatar(b.ImagePath, b.Name)<a href={ templ.URL(fmt.Sprintf("/world/%d", b.ID)) }>{ b.Name }</a></td>
								<td>{ fmt.Sprintf("%d", b.ChatCount) }</td>
								<td>{ fmt.Sprintf("%d", b.EntryCount) }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-lorebook-%d", b.ID), []MenuAction{
										{Label: i18n.T(ctx, "world.hide_into_vault"), Action: fmt.Sprintf("/vault/worlds/%d/in", b.ID)},
										{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/world/%d/delete", b.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
				</div>
			</div>
			@pagerNav(pager)
			@viewToggleScript()
			@searchFilterScript()
		}

		@lorebookCreateModal(false)
		@ImportModal("lorebook-import-modal", "/world/import", false)
		@tabsScript()
	}
}

// lorebookCreateModal is World's "Add a lorebook" dialog, shared with
// the Vault's Worlds-tab "+" (vaulted: posts vault=1, see
// WorldHandlers.Create).
templ lorebookCreateModal(vaulted bool) {
	<dialog id="lorebook-modal">
		<article>
			<header>
				<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
				<strong>
					if vaulted {
						{ i18n.T(ctx, "world.add_hidden") }
					} else {
						{ i18n.T(ctx, "world.add") }
					}
				</strong>
			</header>
			<form method="post" action="/world" enctype="multipart/form-data">
				if vaulted {
					<input type="hidden" name="vault" value="1"/>
				}
				<label>
					{ i18n.T(ctx, "world.field_name") }
					<input type="text" name="name" required="required"/>
				</label>
				@ImageField("", "")
				<button type="submit">{ i18n.T(ctx, "world.add_submit") }</button>
			</form>
		</article>
	</dialog>
}

templ LorebookPage(book db.Lorebook, entries []db.LorebookEntry, editingEntry *db.LorebookEntry, pager Pager) {
	@Layout(book.Name, "worlds") {
		if book.IsVaulted {
			@BackLink("/vault?tab=worlds", i18n.T(ctx, "common.nav_vault"))
		} else {
			@BackLink("/world", i18n.T(ctx, "world.title"))
		}
		<h1>{ book.Name }</h1>
		<p class="entry-count-sub">{ entryCountLabel(ctx, len(entries)) }</p>
		<form method="post" action={ templ.URL(fmt.Sprintf("/world/%d", book.ID)) } enctype="multipart/form-data">
			<label>
				{ i18n.T(ctx, "world.field_name") }
				<input type="text" name="name" value={ book.Name } required="required"/>
			</label>
			@ImageField(book.ImagePath, book.Name)
			<button type="submit">{ i18n.T(ctx, "world.rename") }</button>
		</form>

		<!-- Collapsible so a big imported book (hundreds of entries)
		     doesn't bury the Add button and the rest of the page:
		     content-aware default like ImageField — open when short
		     (≤ 10 entries) or while paging through it (?page= present),
		     collapsed otherwise. The summary carries the count so
		     collapsing never hides how big the book is. -->
		<details class="entries-section" open?={ len(entries) <= 10 || pager.Requested }>
			<summary><h2>{ i18n.T(ctx, "world.entries_heading") }</h2> <span class="entries-summary-count">{ entryCountLabel(ctx, len(entries)) }</span></summary>
		if len(entries) == 0 {
			<p><em>{ i18n.T(ctx, "world.entries_empty") }</em></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "world.col_keys") }</th>
						<th>{ i18n.T(ctx, "world.col_trigger") }</th>
						<th>{ i18n.T(ctx, "world.col_order") }</th>
						<th>{ i18n.T(ctx, "world.col_probability") }</th>
						<th>{ i18n.T(ctx, "world.col_enabled") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, e := range pageOf(entries, pager) {
						<tr>
							<td>@lorebookKeysCell(book.ID, e.ID, e.Keys)</td>
							<td>{ e.TriggerStrategy }</td>
							<td>{ fmt.Sprintf("%d", e.InsertionOrder) }</td>
							<td>{ fmt.Sprintf("%d", e.Probability) }</td>
							<td>
								<form method="post" action={ templ.URL(fmt.Sprintf("/world/%d/entries/%d/toggle?page=%d", book.ID, e.ID, pager.Page)) } class="enabled-toggle">
									if e.Enabled {
										<button type="submit" aria-label={ i18n.T(ctx, "world.disable_entry") } title={ i18n.T(ctx, "world.disable_entry") }>✅</button>
									} else {
										<button type="submit" aria-label={ i18n.T(ctx, "world.enable_entry") } title={ i18n.T(ctx, "world.enable_entry") }>❌</button>
									}
								</form>
							</td>
							<td>
								@OptionsMenu(fmt.Sprintf("options-entry-%d", e.ID), []MenuAction{
									{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/world/%d/entries/%d/delete?page=%d", book.ID, e.ID, pager.Page), Danger: true},
								})
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagerNav(pager)
			@lorebookKeysScript()
		}
		</details>

		<button type="button" class="create-button" aria-label={ i18n.T(ctx, "world.add_entry") } title={ i18n.T(ctx, "world.add_entry") } onclick="document.getElementById('entry-modal').setAttribute('open','')">+</button>

		<dialog id="entry-modal" open?={ editingEntry != nil }>
			<article>
				<header>
					<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
					<strong>
						if editingEntry != nil {
							{ i18n.T(ctx, "world.edit_entry") }
						} else {
							{ i18n.T(ctx, "world.add_entry") }
						}
					</strong>
				</header>
				@lorebookEntryForm(book, editingEntry, pager.Page)
			</article>
		</dialog>
	}
}

// lorebookKeysCell shows an entry's trigger keys plus a count badge
// (Lord's ask — an imported card's lorebook can carry dozens of keys
// per entry, no way to size that at a glance before this). Two or
// fewer keys just render in full, same as before; past that, only
// the first two show plus a "▾ N keys" toggle above AND a mirrored
// "▴ Collapse" below the now-expanded list — so collapsing a long
// list back down doesn't mean scrolling back up to find the control
// that opened it. The <a> still goes straight to editing the entry;
// the toggles are separate siblings, not nested inside it, so they
// don't also trigger that navigation.
templ lorebookKeysCell(bookID, entryID int64, keys []string) {
	{{ editHref := templ.URL(fmt.Sprintf("/world/%d/entries/%d/edit", bookID, entryID)) }}
	if len(keys) <= 2 {
		<a href={ editHref }>{ joinKeys(keys) }</a>
	} else {
		{{ preview := joinKeys(previewKeys(keys, 2)) + "…" }}
		{{ full := joinKeys(keys) }}
		<div class="keys-cell">
			<button type="button" class="keys-toggle" aria-label={ i18n.T(ctx, "world.show_all_keys") } aria-expanded="false" data-expand-label={ "▾ " + keyCountLabel(ctx, len(keys)) } data-collapse-label={ "▴ " + i18n.T(ctx, "world.collapse_word") } data-expand-aria={ i18n.T(ctx, "world.show_all_keys") } data-collapse-aria={ i18n.T(ctx, "world.collapse_keys_aria") } onclick="toggleLorebookKeys(this)">{ "▾ " + keyCountLabel(ctx, len(keys)) }</button>
			<a href={ editHref } class="keys-list" data-preview={ preview } data-full={ full }>{ preview }</a>
			<button type="button" class="keys-toggle keys-toggle-bottom" hidden aria-label={ i18n.T(ctx, "world.collapse_keys_aria") } onclick="toggleLorebookKeys(this)">{ "▴ " + i18n.T(ctx, "world.collapse_word") }</button>
		</div>
	}
}

// lorebookKeysScript drives lorebookKeysCell's expand/collapse — both
// toggles in a cell (top and bottom) flip the same state together, so
// either one works regardless of how far the user scrolled. State
// lives in the bottom toggle's own hidden attribute (visible = "the
// list below is expanded") rather than being re-derived from text
// content, so a label with "…" or odd characters in it can't confuse
// the check.
templ lorebookKeysScript() {
	<script>
		function toggleLorebookKeys(btn) {
			var cell = btn.closest(".keys-cell");
			var top = cell.querySelector(".keys-toggle:not(.keys-toggle-bottom)");
			var bottom = cell.querySelector(".keys-toggle-bottom");
			var link = cell.querySelector(".keys-list");
			var expanding = bottom.hidden;
			link.textContent = expanding ? link.dataset.full : link.dataset.preview;
			top.textContent = expanding ? top.dataset.collapseLabel : top.dataset.expandLabel;
			// Keep the accessible name in step with the visible label.
			top.setAttribute("aria-label", expanding ? top.dataset.collapseAria : top.dataset.expandAria);
			top.setAttribute("aria-expanded", String(expanding));
			bottom.hidden = !expanding;
		}
	</script>
}

templ lorebookEntryForm(book db.Lorebook, editing *db.LorebookEntry, page int) {
	{{
	action := fmt.Sprintf("/world/%d/entries?page=%d", book.ID, page)
	keys, content, triggerStrategy := "", "", "selective"
	insertionOrder, probability := "0", "100"
	enabled := true
	if editing != nil {
		action = fmt.Sprintf("/world/%d/entries/%d?page=%d", book.ID, editing.ID, page)
		keys = joinKeys(editing.Keys)
		content = editing.Content
		triggerStrategy = editing.TriggerStrategy
		insertionOrder = fmt.Sprintf("%d", editing.InsertionOrder)
		probability = fmt.Sprintf("%d", editing.Probability)
		enabled = editing.Enabled
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<label>
			{ i18n.T(ctx, "world.field_keys") }
			<input type="text" name="keys" value={ keys } placeholder={ i18n.T(ctx, "world.field_keys_placeholder") }/>
		</label>
		<label>
			{ i18n.T(ctx, "world.field_content") }
			<textarea name="content" required="required">{ content }</textarea>
		</label>
		<label>
			{ i18n.T(ctx, "world.field_trigger") }
			<select name="trigger_strategy">
				<option value="selective" selected?={ triggerStrategy == "selective" }>{ i18n.T(ctx, "world.trigger_selective") }</option>
				<option value="constant" selected?={ triggerStrategy == "constant" }>{ i18n.T(ctx, "world.trigger_constant") }</option>
			</select>
			<small>{ i18n.T(ctx, "world.field_trigger_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "world.field_order") }
			<input type="number" name="insertion_order" value={ insertionOrder }/>
			<small>{ i18n.T(ctx, "world.field_order_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "world.field_probability") }
			<input type="number" name="probability" value={ probability } min="0" max="100"/>
			<small>{ i18n.T(ctx, "world.field_probability_help") }</small>
		</label>
		<label>
			<input type="checkbox" name="enabled" checked?={ enabled }/>
			{ i18n.T(ctx, "world.field_enabled") }
			<small>{ i18n.T(ctx, "world.field_enabled_help") }</small>
		</label>
		<button type="submit">
			if editing != nil {
				{ i18n.T(ctx, "common.action_save") }
			} else {
				{ i18n.T(ctx, "world.add_entry_submit") }
			}
		</button>
	</form>
}
