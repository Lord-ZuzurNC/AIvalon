package web

import (
	"fmt"
	"strconv"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

templ SettingsPage(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, systemPromptTemplate string) {
	@Layout("Settings", "Settings") {
		@SettingsPageBody(profiles, editing, personas, editingPersona, systemPromptTemplate)
	}
}

templ SettingsPageBody(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, systemPromptTemplate string) {
	<h1>Settings</h1>
	<div class="tabs">
		<div role="tablist" class="tab-list">
			<button type="button" class="tab-btn" data-tab-target="profiles" aria-selected="true" onclick="switchSettingsTab(this)">Backend profiles</button>
			<button type="button" class="tab-btn" data-tab-target="persona" aria-selected="false" onclick="switchSettingsTab(this)">Your persona</button>
			<button type="button" class="tab-btn" data-tab-target="prompt" aria-selected="false" onclick="switchSettingsTab(this)">System prompt</button>
		</div>

		<div data-tab-panel="profiles">
			if len(profiles) == 0 {
				<p><em>No backend profile yet — add one below to start chatting.</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Kind</th>
							<th>Base URL</th>
							<th>Model</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range profiles {
							<tr>
								<td><a href={ templ.URL(fmt.Sprintf("/settings/backend-profiles/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ p.Kind }</td>
								<td>{ p.BaseURL }</td>
								<td>{ p.Model }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-profile-%d", p.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/settings/backend-profiles/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('profile-modal').setAttribute('open','')">Add a profile</button>

			<dialog id="profile-modal" open?={ editing != nil }>
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editing != nil {
								Edit profile
							} else {
								Add a profile
							}
						</strong>
					</header>
					@backendProfileForm(editing)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="persona" hidden="hidden">
			<p>How you're represented to the AI. A session with none picked uses a built-in default ("User").</p>
			if len(personas) == 0 {
				<p><em>No persona yet — add one below, or skip it and sessions use the "User" default.</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range personas {
							<tr>
								<td><a href={ templ.URL(fmt.Sprintf("/settings/personas/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ p.Description }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-persona-%d", p.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/settings/personas/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('persona-modal').setAttribute('open','')">Add a persona</button>

			<dialog id="persona-modal" open?={ editingPersona != nil }>
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editingPersona != nil {
								Edit persona
							} else {
								Add a persona
							}
						</strong>
					</header>
					@personaForm(editingPersona)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="prompt" hidden="hidden">
			<p>
				How the world/narrator is instructed. Placeholders:
				<code>{ "{{persona_name}}" }</code>, <code>{ "{{persona_description}}" }</code>,
				<code>{ "{{characters}}" }</code> (the attached character cards, or a fallback
				instruction to improvise when there are none), and <code>{ "{{lorebook}}" }</code>
				(the session's attached Lorebook's entries that are active this turn — see World).
			</p>
			@systemPromptForm(systemPromptTemplate)
		</div>
	</div>
	<script>
		// Settings tabs: plain [hidden] + aria-selected toggling, no
		// framework — if editing or persona modals open server-side
		// (GET .../edit re-renders this page with editing != nil), the
		// relevant tab is switched to automatically so the opened
		// dialog isn't hidden behind the wrong panel.
		function switchSettingsTab(button) {
			var target = button.dataset.tabTarget;
			button.parentElement.querySelectorAll(".tab-btn").forEach(function (btn) {
				btn.setAttribute("aria-selected", String(btn === button));
			});
			button.closest(".tabs").querySelectorAll("[data-tab-panel]").forEach(function (panel) {
				panel.hidden = panel.dataset.tabPanel !== target;
			});
		}
		(function () {
			var openDialog = document.querySelector(".tabs dialog[open]");
			if (openDialog) {
				var panel = openDialog.closest("[data-tab-panel]");
				if (panel) {
					var btn = document.querySelector('.tab-btn[data-tab-target="' + panel.dataset.tabPanel + '"]');
					if (btn) {
						switchSettingsTab(btn);
					}
				}
			}
		})();
	</script>
}

templ systemPromptForm(template string) {
	<form method="post" action="/settings/system-prompt">
		<textarea name="system_prompt_template" rows="16">{ template }</textarea>
		<button type="submit">Save</button>
	</form>
	<form method="post" action="/settings/system-prompt/reset" style="display:inline">
		<button type="submit">Reset to default</button>
	</form>
}

templ backendProfileForm(editing *db.BackendProfile) {
	{{
	action := "/settings/backend-profiles"
	name, baseURL, model, apiKey := "", "", "", ""
	temperature, topP := "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/backend-profiles/%d", editing.ID)
		name, baseURL, model, apiKey = editing.Name, editing.BaseURL, editing.Model, editing.APIKey
		if v, ok := editing.ModelParams["temperature"]; ok {
			temperature = strconv.FormatFloat(v, 'f', -1, 64)
		}
		if v, ok := editing.ModelParams["top_p"]; ok {
			topP = strconv.FormatFloat(v, 'f', -1, 64)
		}
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<label>
			Name
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			Base URL
			<input type="url" name="base_url" value={ baseURL } placeholder="http://127.0.0.1:11434/v1" required="required"/>
		</label>
		<label>
			Model
			<input type="text" name="model" value={ model } placeholder="llama3.1 (some backends ignore this)"/>
		</label>
		<label>
			API key (optional)
			<input type="password" name="api_key" value={ apiKey }/>
		</label>
		<label>
			Temperature
			<input type="number" name="temperature" value={ temperature } step="0.01" min="0" max="2"/>
		</label>
		<label>
			Top P
			<input type="number" name="top_p" value={ topP } step="0.01" min="0" max="1"/>
		</label>
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add profile
			}
		</button>
	</form>
}

templ personaForm(editing *db.Persona) {
	{{
	action := "/settings/personas"
	name, description := "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/personas/%d", editing.ID)
		name, description = editing.Name, editing.Description
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<label>
			Name
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			Description
			<textarea name="description">{ description }</textarea>
		</label>
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add persona
			}
		</button>
	</form>
}
