package web

import (
	"fmt"
	"strconv"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

templ SettingsPage(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, appSettings db.AppSettings) {
	@Layout("Settings", "Settings") {
		@SettingsPageBody(profiles, editing, personas, editingPersona, appSettings)
	}
}

templ SettingsPageBody(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, appSettings db.AppSettings) {
	{{
	// Which tab opens active — defaults to "profiles", but editing a
	// persona (reached via /settings/personas/{id}/edit) must land on
	// the Persona tab directly: the panel it's hardcoded as hidden
	// (hidden ancestors hide a plain-attribute <dialog> too, open or
	// not) meant the first click just silently did nothing until a
	// second click on the Persona tab actually revealed the already-
	// open modal underneath (Lord's bug report).
	activeTab := "profiles"
	if editingPersona != nil {
		activeTab = "persona"
	}
	}}
	<h1>Settings</h1>
	<div class="tabs">
		<div role="tablist" class="tab-list">
			<button type="button" role="tab" class="tab-btn" data-tab-target="profiles" aria-selected={ fmt.Sprintf("%t", activeTab == "profiles") } onclick="switchTabs(this)">Backend profiles</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="persona" aria-selected={ fmt.Sprintf("%t", activeTab == "persona") } onclick="switchTabs(this)">Your persona</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="prompt" aria-selected={ fmt.Sprintf("%t", activeTab == "prompt") } onclick="switchTabs(this)">System prompt</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="imports" aria-selected={ fmt.Sprintf("%t", activeTab == "imports") } onclick="switchTabs(this)">Imports</button>
		</div>

		<div data-tab-panel="profiles" hidden?={ activeTab != "profiles" }>
			if len(profiles) == 0 {
				<p><em>No backend profile yet — add one below to start chatting.</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th></th>
							<th>Name</th>
							<th>Kind</th>
							<th>Base URL</th>
							<th>Model</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range profiles {
							<tr>
								<td hx-get={ fmt.Sprintf("/settings/backend-profiles/%d/ping", p.ID) } hx-trigger="load, every 5s" hx-swap="innerHTML">
									@PingDot(false)
								</td>
								<td><a href={ templ.URL(fmt.Sprintf("/settings/backend-profiles/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ p.Kind }</td>
								<td>{ p.BaseURL }</td>
								<td>{ p.Model }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-profile-%d", p.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/settings/backend-profiles/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('profile-modal').setAttribute('open','')">Add a profile</button>

			<dialog id="profile-modal" open?={ editing != nil }>
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editing != nil {
								Edit profile
							} else {
								Add a profile
							}
						</strong>
					</header>
					@backendProfileForm(editing)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="persona" hidden?={ activeTab != "persona" }>
			<p>How you're represented to the AI. A session with none picked uses a built-in default ("User").</p>
			if len(personas) == 0 {
				<p><em>No persona yet — add one below, or skip it and sessions use the "User" default.</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range personas {
							<tr>
								<td>@Avatar(p.ImagePath, p.Name)<a href={ templ.URL(fmt.Sprintf("/settings/personas/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ p.Description }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-persona-%d", p.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/settings/personas/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('persona-modal').setAttribute('open','')">Add a persona</button>

			<dialog id="persona-modal" open?={ editingPersona != nil }>
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editingPersona != nil {
								Edit persona
							} else {
								Add a persona
							}
						</strong>
					</header>
					@personaForm(editingPersona)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="prompt" hidden?={ activeTab != "prompt" }>
			<p>
				How the world/narrator is instructed. Placeholders:
				<code>{ "{{persona_name}}" }</code>, <code>{ "{{persona_description}}" }</code>,
				<code>{ "{{characters}}" }</code> (the attached character cards, or a fallback
				instruction to improvise when there are none), and <code>{ "{{lorebook}}" }</code>
				(the session's attached Lorebook's entries that are active this turn — see World).
			</p>
			@systemPromptForm(appSettings.SystemPromptTemplate)
			@contextBudgetForm(appSettings.ContextBudgetChars)
		</div>

		<div data-tab-panel="imports" hidden?={ activeTab != "imports" }>
			@importWhitelistForm(appSettings.PNGImportWhitelist)
		</div>
	</div>
	<script>
		// Settings tabs: plain [hidden] + aria-selected toggling, no
		// framework — see templates.templ's tabsScript() for the shared
		// switchTabs() function. If editing or persona modals open
		// server-side (GET .../edit re-renders this page with editing
		// != nil), the relevant tab is switched to automatically so
		// the opened dialog isn't hidden behind the wrong panel.
		(function () {
			var openDialog = document.querySelector(".tabs dialog[open]");
			if (openDialog) {
				var panel = openDialog.closest("[data-tab-panel]");
				if (panel) {
					var btn = document.querySelector('.tab-btn[data-tab-target="' + panel.dataset.tabPanel + '"]');
					if (btn) {
						switchTabs(btn);
					}
				}
			}
		})();
	</script>
	@tabsScript()
}

templ systemPromptForm(template string) {
	<form method="post" action="/settings/system-prompt">
		<textarea name="system_prompt_template" rows="16">{ template }</textarea>
		<button type="submit">Save</button>
	</form>
	<form method="post" action="/settings/system-prompt/reset" style="display:inline">
		<button type="submit">Reset to default</button>
	</form>
}

// contextBudgetForm is AppSettings.ContextBudgetChars' editor — see
// truncateHistoryToBudget (handlers_chat.go) for what it actually cuts.
templ contextBudgetForm(budget int) {
	<form method="post" action="/settings/context-budget">
		<label>
			Context budget (characters)
			<input type="number" name="context_budget_chars" value={ strconv.Itoa(budget) } min="0" step="1000"/>
			<small>Upper limit on what's sent to the model per reply (system prompt + chat history). Roughly 4 characters per token, so 24000 ≈ 6k tokens — keep it comfortably under your backend's context size. When a long chat goes over, the oldest messages are left out first (the system prompt never is) and the chat page says so. 0 means no limit.</small>
		</label>
		<button type="submit">Save</button>
	</form>
}

// importWhitelistForm edits AppSettings.PNGImportWhitelist — one host
// per line; see checkImportHost (handlers_import.go) for the rules.
templ importWhitelistForm(hosts []string) {
	<form method="post" action="/settings/import-whitelist">
		<label>
			Allowed domains for URL imports (one per line)
			<textarea name="png_import_whitelist" rows="8" spellcheck="false" autocomplete="off">{ db.JoinHostList(hosts) }</textarea>
			<small>Character Card PNG imports from these domains are allowed in addition to 127.0.0.1; JSON imports are always restricted to 127.0.0.1. Exact hostname match (www.example.com and example.com are different entries); port is ignored.</small>
		</label>
		<button type="submit">Save</button>
	</form>
}

templ backendProfileForm(editing *db.BackendProfile) {
	{{
	action := "/settings/backend-profiles"
	idStr, name, baseURL, model := "", "", "", ""
	hasKey := false
	temperature, topP := "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/backend-profiles/%d", editing.ID)
		idStr = fmt.Sprintf("%d", editing.ID)
		name, baseURL, model = editing.Name, editing.BaseURL, editing.Model
		hasKey = editing.APIKey != ""
		if v, ok := editing.ModelParams["temperature"]; ok {
			temperature = strconv.FormatFloat(v, 'f', -1, 64)
		}
		if v, ok := editing.ModelParams["top_p"]; ok {
			topP = strconv.FormatFloat(v, 'f', -1, 64)
		}
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<input type="hidden" name="id" value={ idStr }/>
		<label>
			Name
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			Base URL
			<input type="url" name="base_url" value={ baseURL } placeholder="http://127.0.0.1:11434/v1" required="required"/>
		</label>
		<label>
			Model
			<input type="text" name="model" value={ model } placeholder="llama3.1 (some backends ignore this)"/>
		</label>
		<label>
			API key (optional)
			if hasKey {
				<input type="password" name="api_key" placeholder="•••••••• (leave blank to keep the current key)" autocomplete="new-password"/>
			} else {
				<input type="password" name="api_key" placeholder="(none set)" autocomplete="new-password"/>
			}
		</label>
		<label>
			Temperature
			<input type="number" name="temperature" value={ temperature } step="0.01" min="0" max="2"/>
		</label>
		<label>
			Top P
			<input type="number" name="top_p" value={ topP } step="0.01" min="0" max="1"/>
		</label>
		<div class="test-row">
			<button type="button" class="secondary" hx-post="/settings/backend-profiles/test" hx-include="closest form" hx-target="#test-result" hx-swap="innerHTML" hx-indicator="#test-spinner">Test connection</button>
			<span id="test-spinner" class="htmx-indicator">Testing…</span>
		</div>
		<div id="test-result"></div>
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add profile
			}
		</button>
	</form>
}

templ personaForm(editing *db.Persona) {
	{{
	action := "/settings/personas"
	name, description, imagePath := "", "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/personas/%d", editing.ID)
		name, description, imagePath = editing.Name, editing.Description, editing.ImagePath
	}
	}}
	<form method="post" action={ templ.URL(action) } enctype="multipart/form-data">
		<label>
			Name
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			Description
			<textarea name="description">{ description }</textarea>
		</label>
		@ImageField(imagePath, name)
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add persona
			}
		</button>
	</form>
}

// PingDot is the recurring healthcheck fragment — htmx re-fetches
// this every 5s (see its hx-trigger in the profile list row) and
// swaps it in place, so the dot's color always reflects the latest
// poll without a page reload.
templ PingDot(reachable bool) {
	if reachable {
		<span class="ping-dot ping-ok" title="Reachable (TCP)">●</span>
	} else {
		<span class="ping-dot ping-down" title="Unreachable (TCP)">●</span>
	}
}

// TestResult is the Test button's own fragment — a real HTTP
// exercise of the backend's /models endpoint, not just the socket
// pingBackend checks every 5s, so this can fail on auth/path issues
// pingBackend wouldn't catch.
templ TestResult(err error, modelCount int) {
	if err != nil {
		<p class="test-result test-fail">❌ { err.Error() }</p>
	} else if modelCount > 0 {
		<p class="test-result test-ok">✅ Reachable — { fmt.Sprintf("%d model(s) listed", modelCount) }</p>
	} else {
		<p class="test-result test-ok">✅ Reachable</p>
	}
}
