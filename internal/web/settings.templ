package web

import (
	"fmt"
	"strconv"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
	"github.com/Lord-ZuzurNC/AIvalon/internal/i18n"
)

templ SettingsPage(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, imagePresets []db.ImagePreset, editingImagePreset *db.ImagePreset, imagePresetErr string, appSettings db.AppSettings) {
	@Layout(i18n.T(ctx, "settings.title"), "settings") {
		@SettingsPageBody(profiles, editing, personas, editingPersona, imagePresets, editingImagePreset, imagePresetErr, appSettings)
	}
}

templ SettingsPageBody(profiles []db.BackendProfile, editing *db.BackendProfile, personas []db.Persona, editingPersona *db.Persona, imagePresets []db.ImagePreset, editingImagePreset *db.ImagePreset, imagePresetErr string, appSettings db.AppSettings) {
	{{
	// Which tab opens active — defaults to "profiles", but editing a
	// persona (reached via /settings/personas/{id}/edit) must land on
	// the Persona tab directly: the panel it's hardcoded as hidden
	// (hidden ancestors hide a plain-attribute <dialog> too, open or
	// not) meant the first click just silently did nothing until a
	// second click on the Persona tab actually revealed the already-
	// open modal underneath (Lord's bug report).
	activeTab := "profiles"
	if editingPersona != nil {
		activeTab = "persona"
	}
	if editingImagePreset != nil {
		activeTab = "image-presets"
	}
	}}
	<h1>{ i18n.T(ctx, "settings.title") }</h1>
	<div class="tabs">
		<div role="tablist" class="tab-list">
			<button type="button" role="tab" class="tab-btn" data-tab-target="profiles" aria-selected={ fmt.Sprintf("%t", activeTab == "profiles") } onclick="switchTabs(this)">{ i18n.T(ctx, "settings.tab_profiles") }</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="persona" aria-selected={ fmt.Sprintf("%t", activeTab == "persona") } onclick="switchTabs(this)">{ i18n.T(ctx, "settings.tab_persona") }</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="prompt" aria-selected={ fmt.Sprintf("%t", activeTab == "prompt") } onclick="switchTabs(this)">{ i18n.T(ctx, "settings.tab_prompt") }</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="imports" aria-selected={ fmt.Sprintf("%t", activeTab == "imports") } onclick="switchTabs(this)">{ i18n.T(ctx, "settings.tab_imports") }</button>
			<button type="button" role="tab" class="tab-btn" data-tab-target="image-presets" aria-selected={ fmt.Sprintf("%t", activeTab == "image-presets") } onclick="switchTabs(this)">{ i18n.T(ctx, "settings.tab_image_presets") }</button>
		</div>

		<div data-tab-panel="profiles" hidden?={ activeTab != "profiles" }>
			if len(profiles) == 0 {
				<p><em>{ i18n.T(ctx, "settings.profiles_empty") }</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th></th>
							<th>{ i18n.T(ctx, "settings.col_name") }</th>
							<th>{ i18n.T(ctx, "settings.col_kind") }</th>
							<th>{ i18n.T(ctx, "settings.col_base_url") }</th>
							<th>{ i18n.T(ctx, "settings.col_model") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range profiles {
							<tr>
								<td hx-get={ fmt.Sprintf("/settings/backend-profiles/%d/ping", p.ID) } hx-trigger="load, every 5s" hx-swap="innerHTML">
									@PingDot(false)
								</td>
								<td><a href={ templ.URL(fmt.Sprintf("/settings/backend-profiles/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ p.Kind }</td>
								<td>{ p.BaseURL }</td>
								<td>{ p.Model }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-profile-%d", p.ID), []MenuAction{
										{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/settings/backend-profiles/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('profile-modal').setAttribute('open','')">{ i18n.T(ctx, "settings.add_profile") }</button>

			<dialog id="profile-modal" open?={ editing != nil }>
				<article>
					<header>
						<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editing != nil {
								{ i18n.T(ctx, "settings.edit_profile") }
							} else {
								{ i18n.T(ctx, "settings.add_profile") }
							}
						</strong>
					</header>
					@backendProfileForm(editing)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="persona" hidden?={ activeTab != "persona" }>
			<p>{ i18n.T(ctx, "settings.persona_intro") }</p>
			if len(personas) == 0 {
				<p><em>{ i18n.T(ctx, "settings.persona_empty") }</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "settings.col_name") }</th>
							<th>{ i18n.T(ctx, "settings.col_chats") }</th>
							<th>{ i18n.T(ctx, "settings.col_description") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range personas {
							<tr>
								<td>@Avatar(p.ImagePath, p.Name)<a href={ templ.URL(fmt.Sprintf("/settings/personas/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ fmt.Sprintf("%d", p.ChatCount) }</td>
								<td>{ p.Description }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-persona-%d", p.ID), []MenuAction{
										{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/settings/personas/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('persona-modal').setAttribute('open','')">{ i18n.T(ctx, "settings.add_persona") }</button>

			<dialog id="persona-modal" open?={ editingPersona != nil }>
				<article>
					<header>
						<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editingPersona != nil {
								{ i18n.T(ctx, "settings.edit_persona") }
							} else {
								{ i18n.T(ctx, "settings.add_persona") }
							}
						</strong>
					</header>
					@personaForm(editingPersona)
				</article>
			</dialog>
		</div>

		<div data-tab-panel="prompt" hidden?={ activeTab != "prompt" }>
			@templ.Raw(i18n.T(ctx, "settings.prompt_help_html"))
			@systemPromptForm(appSettings.SystemPromptTemplate)
			@contextBudgetForm(appSettings.ContextBudgetChars)
		</div>

		<div data-tab-panel="imports" hidden?={ activeTab != "imports" }>
			@importWhitelistForm(appSettings.PNGImportWhitelist)
		</div>

		<div data-tab-panel="image-presets" hidden?={ activeTab != "image-presets" }>
			<p>{ i18n.T(ctx, "settings.image_presets_intro") }</p>
			if len(imagePresets) == 0 {
				<p><em>{ i18n.T(ctx, "settings.image_presets_empty") }</em></p>
			} else {
				<table>
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "settings.col_name") }</th>
							<th>{ i18n.T(ctx, "settings.col_steps") }</th>
							<th>{ i18n.T(ctx, "settings.col_cfg") }</th>
							<th>{ i18n.T(ctx, "settings.col_size") }</th>
							<th>{ i18n.T(ctx, "settings.col_sampler") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range imagePresets {
							<tr>
								<td><a href={ templ.URL(fmt.Sprintf("/settings/image-presets/%d/edit", p.ID)) }>{ p.Name }</a></td>
								<td>{ strconv.Itoa(p.Steps) }</td>
								<td>{ strconv.FormatFloat(p.CFGScale, 'f', -1, 64) }</td>
								<td>{ fmt.Sprintf("%d×%d", p.Width, p.Height) }</td>
								<td>{ p.SamplerName }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-image-preset-%d", p.ID), []MenuAction{
										{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/settings/image-presets/%d/delete", p.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button type="button" onclick="document.getElementById('image-preset-modal').setAttribute('open','')">{ i18n.T(ctx, "settings.add_preset") }</button>

			<dialog id="image-preset-modal" open?={ editingImagePreset != nil }>
				<article>
					<header>
						<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>
							if editingImagePreset != nil && editingImagePreset.ID != 0 {
								{ i18n.T(ctx, "settings.edit_preset") }
							} else {
								{ i18n.T(ctx, "settings.add_preset") }
							}
						</strong>
					</header>
					@imagePresetForm(editingImagePreset, imagePresetErr, imageProfiles(profiles))
				</article>
			</dialog>
		</div>
	</div>
	<script>
		// Settings tabs: plain [hidden] + aria-selected toggling, no
		// framework — see templates.templ's tabsScript() for the shared
		// switchTabs() function. If editing or persona modals open
		// server-side (GET .../edit re-renders this page with editing
		// != nil), the relevant tab is switched to automatically so
		// the opened dialog isn't hidden behind the wrong panel.
		(function () {
			var openDialog = document.querySelector(".tabs dialog[open]");
			if (openDialog) {
				var panel = openDialog.closest("[data-tab-panel]");
				if (panel) {
					var btn = document.querySelector('.tab-btn[data-tab-target="' + panel.dataset.tabPanel + '"]');
					if (btn) {
						switchTabs(btn);
					}
				}
			}
		})();
	</script>
	@tabsScript()
}

templ systemPromptForm(template string) {
	<form method="post" action="/settings/system-prompt">
		<textarea name="system_prompt_template" rows="16">{ template }</textarea>
		<button type="submit">{ i18n.T(ctx, "common.action_save") }</button>
	</form>
	<form method="post" action="/settings/system-prompt/reset" style="display:inline">
		<button type="submit">{ i18n.T(ctx, "settings.reset_default") }</button>
	</form>
}

// contextBudgetForm is AppSettings.ContextBudgetChars' editor — see
// truncateHistoryToBudget (handlers_chat.go) for what it actually cuts.
templ contextBudgetForm(budget int) {
	<form method="post" action="/settings/context-budget">
		<label>
			{ i18n.T(ctx, "settings.context_budget_label") }
			<input type="number" name="context_budget_chars" value={ strconv.Itoa(budget) } min="0" step="1000"/>
			<small>{ i18n.T(ctx, "settings.context_budget_help") }</small>
		</label>
		<button type="submit">{ i18n.T(ctx, "common.action_save") }</button>
	</form>
}

// importWhitelistForm edits AppSettings.PNGImportWhitelist — one host
// per line; see checkImportHost (handlers_import.go) for the rules.
templ importWhitelistForm(hosts []string) {
	<form method="post" action="/settings/import-whitelist">
		<label>
			{ i18n.T(ctx, "settings.whitelist_label") }
			<textarea name="png_import_whitelist" rows="8" spellcheck="false" autocomplete="off">{ db.JoinHostList(hosts) }</textarea>
			<small>{ i18n.T(ctx, "settings.whitelist_help") }</small>
		</label>
		<button type="submit">{ i18n.T(ctx, "common.action_save") }</button>
	</form>
}

templ backendProfileForm(editing *db.BackendProfile) {
	{{
	action := "/settings/backend-profiles"
	idStr, name, baseURL, model := "", "", "", ""
	kind := "llm"
	hasKey := false
	temperature, topP := "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/backend-profiles/%d", editing.ID)
		idStr = fmt.Sprintf("%d", editing.ID)
		name, baseURL, model = editing.Name, editing.BaseURL, editing.Model
		kind = editing.Kind
		hasKey = editing.APIKey != ""
		if v, ok := editing.ModelParams["temperature"]; ok {
			temperature = strconv.FormatFloat(v, 'f', -1, 64)
		}
		if v, ok := editing.ModelParams["top_p"]; ok {
			topP = strconv.FormatFloat(v, 'f', -1, 64)
		}
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		<input type="hidden" name="id" value={ idStr }/>
		<label>
			{ i18n.T(ctx, "settings.field_name") }
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_kind") }
			<select name="kind">
				<option value="llm" selected?={ kind == "llm" }>{ i18n.T(ctx, "settings.kind_llm") }</option>
				<option value="image" selected?={ kind == "image" }>{ i18n.T(ctx, "settings.kind_image") }</option>
			</select>
			<small>{ i18n.T(ctx, "settings.kind_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_base_url") }
			<input type="url" name="base_url" value={ baseURL } placeholder="http://127.0.0.1:11434/v1" required="required"/>
		</label>
		<div id="model-field">
			@modelFieldInput(model)
		</div>
		<label>
			{ i18n.T(ctx, "settings.field_api_key") }
			if hasKey {
				<input type="password" name="api_key" placeholder={ i18n.T(ctx, "settings.api_key_placeholder_set") } autocomplete="new-password"/>
			} else {
				<input type="password" name="api_key" placeholder={ i18n.T(ctx, "settings.api_key_placeholder_unset") } autocomplete="new-password"/>
			}
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_temperature") }
			<input type="number" name="temperature" value={ temperature } step="0.01" min="0" max="2"/>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_top_p") }
			<input type="number" name="top_p" value={ topP } step="0.01" min="0" max="1"/>
		</label>
		<div class="test-row">
			<button type="button" class="secondary" hx-post="/settings/backend-profiles/test" hx-include="closest form" hx-target="#test-result" hx-swap="innerHTML" hx-indicator="#test-spinner">{ i18n.T(ctx, "settings.test_connection") }</button>
			<span id="test-spinner" class="htmx-indicator">{ i18n.T(ctx, "settings.testing") }</span>
		</div>
		<div id="test-result"></div>
		<button type="submit">
			if editing != nil {
				{ i18n.T(ctx, "common.action_save") }
			} else {
				{ i18n.T(ctx, "settings.add_profile") }
			}
		</button>
	</form>
}

// imagePresetForm edits one ImagePreset. editing == nil is a blank
// "add" form pre-filled with defaultImageParams; editing.ID == 0 is a
// rejected "add" re-rendered with what was submitted.
templ imagePresetForm(editing *db.ImagePreset, errMsg string, imageProfiles []db.BackendProfile) {
	{{
	action := "/settings/image-presets"
	p := defaultImageParams
	if editing != nil {
		p = *editing
		if editing.ID != 0 {
			action = fmt.Sprintf("/settings/image-presets/%d", editing.ID)
		}
	}
	}}
	<form method="post" action={ templ.URL(action) }>
		if errMsg != "" {
			<p class="danger-text" role="alert">{ errMsg }</p>
		}
		<label>
			{ i18n.T(ctx, "settings.field_name") }
			<input type="text" name="name" value={ p.Name } required="required"/>
			<small>{ i18n.T(ctx, "settings.preset_name_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_style_suffix") }
			<input type="text" name="style_suffix" value={ p.StyleSuffix }/>
			<small>{ i18n.T(ctx, "settings.style_suffix_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_negative_prompt") }
			<textarea name="negative_prompt" rows="2">{ p.NegativePrompt }</textarea>
			<small>{ i18n.T(ctx, "settings.negative_prompt_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_steps") }
			<input type="number" name="steps" value={ strconv.Itoa(p.Steps) } min="1" max="150" required="required"/>
			<small>{ i18n.T(ctx, "settings.steps_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_cfg_scale") }
			<input type="number" name="cfg_scale" value={ strconv.FormatFloat(p.CFGScale, 'f', -1, 64) } step="0.5" min="1" max="30" required="required"/>
			<small>{ i18n.T(ctx, "settings.cfg_scale_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_width") }
			<input type="number" name="width" value={ strconv.Itoa(p.Width) } step="8" min="64" max="2048" required="required"/>
			<small>{ i18n.T(ctx, "settings.width_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_height") }
			<input type="number" name="height" value={ strconv.Itoa(p.Height) } step="8" min="64" max="2048" required="required"/>
			<small>{ i18n.T(ctx, "settings.height_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_sampler") }
			<input type="text" name="sampler_name" value={ p.SamplerName } list="sampler-options" required="required"/>
			<datalist id="sampler-options">
				<option value="Euler a"></option>
				<option value="Euler"></option>
				<option value="DPM++ 2M Karras"></option>
				<option value="DPM++ SDE Karras"></option>
				<option value="DPM++ 2M SDE Karras"></option>
				<option value="DDIM"></option>
				<option value="UniPC"></option>
			</datalist>
			<small>{ i18n.T(ctx, "settings.sampler_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_seed") }
			<input type="number" name="seed" value={ strconv.FormatInt(p.Seed, 10) } min="-1" step="1" required="required"/>
			<small>{ i18n.T(ctx, "settings.seed_help") }</small>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_backend") }
			<select name="backend_profile_id">
				<option value="0" selected?={ p.BackendProfileID == 0 }>{ i18n.T(ctx, "settings.backend_choose_at_generation") }</option>
				for _, bp := range imageProfiles {
					<option value={ fmt.Sprintf("%d", bp.ID) } selected?={ p.BackendProfileID == bp.ID }>{ bp.Name }</option>
				}
			</select>
			<small>{ i18n.T(ctx, "settings.backend_help") }</small>
		</label>
		<button type="submit">
			if editing != nil && editing.ID != 0 {
				{ i18n.T(ctx, "common.action_save") }
			} else {
				{ i18n.T(ctx, "settings.add_preset") }
			}
		</button>
	</form>
}

templ personaForm(editing *db.Persona) {
	{{
	action := "/settings/personas"
	name, description, imagePath := "", "", ""
	if editing != nil {
		action = fmt.Sprintf("/settings/personas/%d", editing.ID)
		name, description, imagePath = editing.Name, editing.Description, editing.ImagePath
	}
	}}
	<form method="post" action={ templ.URL(action) } enctype="multipart/form-data">
		<label>
			{ i18n.T(ctx, "settings.field_name") }
			<input type="text" name="name" value={ name } required="required"/>
		</label>
		<label>
			{ i18n.T(ctx, "settings.field_description") }
			<textarea name="description">{ description }</textarea>
		</label>
		@ImageField(imagePath, name)
		<button type="submit">
			if editing != nil {
				{ i18n.T(ctx, "common.action_save") }
			} else {
				{ i18n.T(ctx, "settings.add_persona") }
			}
		</button>
	</form>
}

// modelFieldInput is the plain free-text Model field — the default
// state, and what a page reload always falls back to (the dropdown
// below is a client-side convenience, never persisted on its own).
templ modelFieldInput(model string) {
	<label>
		{ i18n.T(ctx, "settings.field_model") }
		<input type="text" name="model" value={ model } placeholder="llama3.1 (some backends ignore this)"/>
	</label>
}

// modelFieldSelect replaces the plain input with a dropdown of the
// model IDs a successful Test actually found — Lord's ask: typing a
// model name by hand when the backend already told you what exists
// invites typos. "(Default)" (empty value, same as leaving the old
// input blank) is always first for "don't know / don't care, let
// the backend pick". If the already-set model isn't among the ones
// just listed (stale, or the backend's list is incomplete), it's
// kept as its own trailing option instead of silently dropped —
// switching to the picker should never discard a working value.
templ modelFieldSelect(current string, models []string) {
	{{ currentInList := false }}
	<label>
		{ i18n.T(ctx, "settings.field_model") }
		<select name="model">
			<option value="" selected?={ current == "" }>{ i18n.T(ctx, "settings.model_default_option") }</option>
			for _, m := range models {
				<option value={ m } selected?={ m == current }>{ m }</option>
				if m == current {
					{{ currentInList = true }}
				}
			}
			if current != "" && !currentInList {
				<option value={ current } selected="selected">{ fmt.Sprintf(i18n.T(ctx, "settings.model_current_not_in_list"), current) }</option>
			}
		</select>
	</label>
}

// PingDot is the recurring healthcheck fragment — htmx re-fetches
// this every 5s (see its hx-trigger in the profile list row) and
// swaps it in place, so the dot's color always reflects the latest
// poll without a page reload.
templ PingDot(reachable bool) {
	if reachable {
		<span class="ping-dot ping-ok" title={ i18n.T(ctx, "settings.ping_reachable") }>●</span>
	} else {
		<span class="ping-dot ping-down" title={ i18n.T(ctx, "settings.ping_unreachable") }>●</span>
	}
}

// TestResult is the Test button's own fragment — a real HTTP
// exercise of the backend's /models endpoint, not just the socket
// pingBackend checks every 5s, so this can fail on auth/path issues
// pingBackend wouldn't catch. On success with at least one model
// listed, it also swaps the form's plain Model <input> for a
// <select> of what was found (Lord's ask) via an out-of-band swap
// targeting #model-field (see backendProfileForm) — a failed test or
// a backend that lists nothing leaves the plain text field alone.
templ TestResult(err error, models []string, currentModel string) {
	if err != nil {
		<p class="test-result test-fail">❌ { err.Error() }</p>
	} else if len(models) > 0 {
		<p class="test-result test-ok">✅ { i18n.T(ctx, "settings.test_reachable") } — { fmt.Sprintf(i18n.T(ctx, "settings.test_models_listed"), len(models)) }</p>
		<div id="model-field" hx-swap-oob="true">
			@modelFieldSelect(currentModel, models)
		</div>
	} else {
		<p class="test-result test-ok">✅ { i18n.T(ctx, "settings.test_reachable") }</p>
	}
}
