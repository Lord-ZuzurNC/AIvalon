package web

import (
	"fmt"
	"strings"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
	"github.com/Lord-ZuzurNC/AIvalon/internal/i18n"
)

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<!-- Sidebar-collapsed state must be known before the very
			     first paint — reading it later (even "DOMContentLoaded"-
			     early) means the header paints expanded for one frame
			     then snaps to its collapsed width, visible as a flash on
			     every full-page navigation (every link in this app is a
			     plain <a>, there's no SPA route to skip it). A classless
			     render-blocking script, first thing in <head>, runs
			     before the browser has anything to paint yet — the class
			     goes on <html> (not <body>) because body doesn't exist
			     as a DOM node this early in parsing. -->
			<script>
				(function () {
					try {
						if (localStorage.getItem("aivalon-sidebar-collapsed") === "1") {
							document.documentElement.classList.add("sidebar-collapsed");
						}
					} catch (e) {}
				})();
			</script>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · AIvalon</title>
			<link rel="stylesheet" href="/static/pico.classless.min.css"/>
			<link rel="stylesheet" href="/static/aivalon.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-sse.js"></script>
		</head>
		<body>
			<header>
				<div class="sidebar-header">
					<strong class="brand"><span class="nav-label">AIvalon</span></strong>
					<button id="sidebar-toggle" type="button" aria-label={ i18n.T(ctx, "nav.sidebar_toggle") } aria-expanded="true" title={ i18n.T(ctx, "nav.sidebar_toggle") }>«</button>
				</div>
				<nav class="nav-main">
					<ul>
						@navLink("/chat", "chats", active)
						@navLink("/characters", "characters", active)
						@navLink("/world", "worlds", active)
						@navLink("/vault", "vault", active)
						@navLink("/settings", "settings", active)
					</ul>
				</nav>
				<nav class="nav-footer">
					@languageSwitcher()
					<ul>
						@navLink("/about", "about", active)
					</ul>
				</nav>
			</header>
			<main>
				{ children... }
			</main>
			<script>
				// The <head> script above already set the class before
				// first paint — this just syncs the toggle button's own
				// aria-expanded/glyph to match on load, then wires up the
				// click handler. Deliberately NOT re-applying the class
				// here: doing so a second time is harmless on its own,
				// but keeping "decide the class" in exactly one place
				// (the head script) avoids the two ever disagreeing if
				// one gets edited later and not the other.
				(function () {
					var STORAGE_KEY = "aivalon-sidebar-collapsed";
					var toggle = document.getElementById("sidebar-toggle");
					var root = document.documentElement;

					function syncToggleButton() {
						var collapsed = root.classList.contains("sidebar-collapsed");
						if (toggle) {
							toggle.setAttribute("aria-expanded", String(!collapsed));
							toggle.textContent = collapsed ? "»" : "«";
						}
					}

					syncToggleButton();
					if (toggle) {
						toggle.addEventListener("click", function () {
							var collapsed = !root.classList.contains("sidebar-collapsed");
							root.classList.toggle("sidebar-collapsed", collapsed);
							syncToggleButton();
							localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
						});
					}
				})();
			</script>
			<script>
				// Click-to-dismiss on the backdrop for every <dialog> on the
				// page (create/edit modals): these are opened by toggling the
				// plain `open` attribute (set server-side for "edit", or by
				// the "Add" button's onclick for "create"), not
				// showModal() — so there's no native top-layer/backdrop
				// click-to-close behavior to rely on. A click lands with
				// e.target === the <dialog> element itself only when it hits
				// the dialog's own padding/overlay area; a click on the
				// <article> card inside bubbles from that inner element
				// instead, so this never closes the dialog from a click
				// meant for its content.
				document.addEventListener("click", function (e) {
					if (e.target.tagName === "DIALOG") {
						e.target.removeAttribute("open");
					}
				});
			</script>
			<script>
				// Every row's "⋮" options dropdown (OptionsMenu, see
				// templates.templ) shares this one toggle: close every
				// other open dropdown first (only one makes sense open at
				// a time), then flip the clicked one. A document-level
				// click handler closes whatever's open when the click
				// lands outside any .options-menu — otherwise a stray
				// dropdown stays open after the user clicks elsewhere.
				// aria-expanded on every trigger is kept in sync here, the
				// one place that opens/closes dropdowns, so a screen reader
				// always hears the real state.
				function closeOptionsMenus() {
					document.querySelectorAll(".options-dropdown").forEach(function (m) {
						m.hidden = true;
					});
					document.querySelectorAll(".options-trigger").forEach(function (t) {
						t.setAttribute("aria-expanded", "false");
					});
				}
				function toggleOptionsMenu(id) {
					var menu = document.getElementById(id);
					var wasOpen = !menu.hidden;
					closeOptionsMenus();
					menu.hidden = wasOpen;
					if (!wasOpen) {
						var trigger = document.querySelector('.options-trigger[data-menu-id="' + id + '"]');
						if (trigger) {
							trigger.setAttribute("aria-expanded", "true");
						}
						// Standard menu-button pattern: focus moves into
						// the menu so arrows/Escape (see a11yScript) work
						// straight away from the keyboard.
						var first = menu.querySelector('[role="menuitem"]');
						if (first) {
							first.focus();
						}
					}
				}
				document.addEventListener("click", function (e) {
					if (!e.target.closest(".options-menu")) {
						closeOptionsMenus();
					}
				});
			</script>
			@a11yScript()
			@languageSwitcherScript()
		</body>
	</html>
}

// a11yScript is the keyboard/screen-reader layer every page gets from
// Layout, written once so every <dialog> and "⋮" OptionsMenu inherits
// it:
//   - attribute-toggled dialogs (the create/edit/import modals — opened
//     via setAttribute('open'), NOT showModal(), see the click-to-dismiss
//     script above) get what a modal dialog gives for free: focus moves
//     in on open, Tab/Shift+Tab cycle inside it, Escape closes it, and
//     focus returns to whatever opened it on close. A MutationObserver
//     on the `open` attribute catches every way a dialog opens/closes
//     (button onclick, ✕, backdrop click, Escape) without each caller
//     having to remember to call a helper.
//   - showModal() dialogs (Vault's PIN pads) are skipped — the browser
//     already traps focus, handles Escape and restores focus for those.
//   - an open .options-dropdown closes on Escape (focus back to its ⋮
//     trigger) and Up/Down move between its menu items.
templ a11yScript() {
	<script>
		(function () {
			var FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), summary, [tabindex]:not([tabindex="-1"])';

			function focusables(root) {
				return Array.prototype.filter.call(root.querySelectorAll(FOCUSABLE), function (el) {
					return el.getClientRects().length > 0;
				});
			}
			function isManaged(dialog) {
				return dialog.open && !dialog.matches(":modal");
			}
			function topDialog() {
				var open = Array.prototype.filter.call(document.querySelectorAll("dialog[open]"), isManaged);
				return open.length ? open[open.length - 1] : null;
			}

			function onOpen(dialog) {
				var active = document.activeElement;
				dialog._opener = active && !dialog.contains(active) ? active : null;
				// Skip the header's ✕ (rel="prev") when there's a real
				// field to land on — the first thing a user wants to do
				// in an "Add …" modal is type, not close it again.
				var items = focusables(dialog);
				var target = items.filter(function (el) { return el.getAttribute("rel") !== "prev"; })[0] || items[0];
				if (!target) {
					dialog.setAttribute("tabindex", "-1");
					target = dialog;
				}
				target.focus();
			}
			function onClose(dialog) {
				var opener = dialog._opener;
				dialog._opener = null;
				if (opener && document.contains(opener)) {
					opener.focus();
				}
			}

			new MutationObserver(function (mutations) {
				mutations.forEach(function (m) {
					var dialog = m.target;
					if (dialog.tagName !== "DIALOG" || dialog.matches(":modal")) {
						return;
					}
					if (dialog.open) {
						onOpen(dialog);
					} else {
						onClose(dialog);
					}
				});
			}).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["open"] });

			// Dialogs the server rendered already open (an "edit" URL)
			// never trigger the observer — focus into them on load.
			document.querySelectorAll("dialog[open]").forEach(function (dialog) {
				if (isManaged(dialog)) {
					onOpen(dialog);
				}
			});

			document.addEventListener("keydown", function (e) {
				var dropdown = document.activeElement && document.activeElement.closest(".options-dropdown:not([hidden])");
				if (!dropdown) {
					dropdown = document.querySelector(".options-dropdown:not([hidden])");
				}
				if (dropdown) {
					var trigger = document.querySelector('.options-trigger[data-menu-id="' + dropdown.id + '"]');
					if (e.key === "Escape") {
						e.preventDefault();
						closeOptionsMenus();
						if (trigger) {
							trigger.focus();
						}
						return;
					}
					if (e.key === "ArrowDown" || e.key === "ArrowUp") {
						var menuItems = Array.prototype.slice.call(dropdown.querySelectorAll('[role="menuitem"]'));
						if (menuItems.length) {
							e.preventDefault();
							var i = menuItems.indexOf(document.activeElement);
							var step = e.key === "ArrowDown" ? 1 : -1;
							menuItems[(i + step + menuItems.length) % menuItems.length].focus();
						}
						return;
					}
					if (e.key === "Tab") {
						// Tabbing away from an open menu closes it, so a
						// stray dropdown never lingers behind the focus.
						closeOptionsMenus();
					}
				}

				var dialog = topDialog();
				if (!dialog) {
					return;
				}
				if (e.key === "Escape") {
					e.preventDefault();
					dialog.removeAttribute("open");
					return;
				}
				if (e.key === "Tab") {
					var items = focusables(dialog);
					if (!items.length) {
						e.preventDefault();
						dialog.focus();
						return;
					}
					var first = items[0];
					var last = items[items.length - 1];
					var inside = dialog.contains(document.activeElement);
					if (e.shiftKey && (!inside || document.activeElement === first || document.activeElement === dialog)) {
						e.preventDefault();
						last.focus();
					} else if (!e.shiftKey && (!inside || document.activeElement === last)) {
						e.preventDefault();
						first.focus();
					}
				}
			});
		})();
	</script>
}

templ navLink(href, id, active string) {
	{{ label := i18n.T(ctx, "nav."+id) }}
	if active == id {
		<li>
			<a href={ templ.URL(href) } aria-current="page" title={ label }>
				<span class="nav-label">{ label }</span>
				<span class="nav-initial" aria-hidden="true">@navIcon(id)</span>
			</a>
		</li>
	} else {
		<li>
			<a href={ templ.URL(href) } title={ label }>
				<span class="nav-label">{ label }</span>
				<span class="nav-initial" aria-hidden="true">@navIcon(id)</span>
			</a>
		</li>
	}
}

// languageSwitcher is the small language-code badge Lord asked for,
// sitting above the About link in the nav footer — "EN" by default,
// a click opens a dropdown UPWARD (there's nothing below it to open
// into — it sits right above the sidebar's last item) listing every
// language internal/i18n discovered under web/static/i18n/*.json.
// Reuses the OptionsMenu's own toggleOptionsMenu script (Layout's
// shared script) for open/close — only the trigger's shape (a square
// code badge, not "⋮") and the dropdown's direction differ (see
// aivalon.css's .lang-switcher rules).
//
// Each language is a plain POST form to /settings/language — no JS
// requirement to actually switch, consistent with this app's "every
// link is a plain <a>/<form>, no SPA route" design (see Layout's own
// head-script comment). The hidden "redirect" field is filled in by
// languageSwitcherScript below (location.pathname), not threaded
// through every page's own Go handler, so switching the language
// lands back on the same page instead of always bouncing to /.
//
// Renders nothing when there's at most one language available (a
// fresh checkout with only en.json, or i18n.LoadDir never having run
// — every test in this repo falls in that second case): nothing to
// switch to, nothing to show.
templ languageSwitcher() {
	{{ langs := i18n.Default().Languages() }}
	if len(langs) > 1 {
		{{ current := i18n.FromContext(ctx) }}
		<div class="lang-switcher options-menu">
			<button type="button" class="lang-switcher-trigger options-trigger" aria-label={ i18n.T(ctx, "lang.switcher_label") } aria-haspopup="true" aria-expanded="false" aria-controls="lang-switcher-dropdown" data-menu-id="lang-switcher-dropdown" onclick="toggleOptionsMenu(this.dataset.menuId)">{ strings.ToUpper(current) }</button>
			<div id="lang-switcher-dropdown" class="options-dropdown lang-switcher-dropdown" role="menu" hidden>
				for _, l := range langs {
					<form method="post" action="/settings/language">
						<input type="hidden" name="redirect" class="lang-switcher-redirect" value="/"/>
						<button type="submit" name="lang" value={ l.Code } role="menuitem" aria-current?={ l.Code == current }>{ l.Name }</button>
					</form>
				}
			</div>
		</div>
	}
}

// languageSwitcherScript fills in every languageSwitcher form's
// hidden "redirect" field with the page's own current path+query on
// load — kept client-side (not threaded through every page's Go
// handler as a parameter) so adding the switcher didn't require
// touching every single page-rendering function's signature in the
// app for one extra string.
templ languageSwitcherScript() {
	<script>
		document.querySelectorAll(".lang-switcher-redirect").forEach(function (input) {
			input.value = location.pathname + location.search;
		});
	</script>
}

// navIcon is the collapsed-sidebar glyph for each section — small,
// authored line-art SVGs (not a vendored icon library, not emoji),
// stroke="currentColor" so they pick up the link's own text color for
// free in both the active (gold-on-fill) and inactive states. The World
// icon deliberately mirrors the open-book shape used by the lorebook
// placeholder covers (see web/static/placeholders/) for the same
// "world/lore" visual vocabulary everywhere it shows up.
templ navIcon(id string) {
	switch id {
		case "chats":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 5h16v10H9l-4 4v-4H4V5z"></path>
			</svg>
		case "worlds":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 6c-1.5-1.3-4-2-7-2v13c3 0 5.5.7 7 2 1.5-1.3 4-2 7-2V4c-3 0-5.5.7-7 2z"></path>
				<path d="M12 6v13"></path>
			</svg>
		case "characters":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="8" r="3.2"></circle>
				<path d="M5 20c0-4 3.5-6 7-6s7 2 7 6"></path>
			</svg>
		case "vault":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<rect x="5" y="11" width="14" height="9" rx="2"></rect>
				<path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
			</svg>
		case "settings":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 7h10M4 12h16M4 17h7"></path>
				<circle cx="16" cy="7" r="1.6" fill="currentColor" stroke="none"></circle>
				<circle cx="9" cy="17" r="1.6" fill="currentColor" stroke="none"></circle>
			</svg>
		case "about":
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 11v5" stroke-linecap="round"></path>
				<circle cx="12" cy="7.8" r="0.9" fill="currentColor" stroke="none"></circle>
			</svg>
		default:
			{{ initial := "" }}
			if len(id) > 0 {
				{{ initial = id[0:1] }}
			}
			{ initial }
	}
}

templ Placeholder(section string) {
	<h1>{ section }</h1>
	<p>Not built yet — scaffold only.</p>
}

// AboutPage — repo link, AI co-authorship disclosure, version, and
// license, all Lord's own explicit ask: anyone (including him,
// months later) landing on this page should know exactly what this
// is and isn't without digging through source.
templ AboutPage() {
	@Layout(i18n.T(ctx, "about.title"), "about") {
		<h1>{ i18n.T(ctx, "about.heading") }</h1>
		<p>{ i18n.T(ctx, "about.description") }</p>
		<dl class="about-list">
			<dt>{ i18n.T(ctx, "about.version_label") }</dt>
			<dd>{ AppVersion }</dd>
			<dt>{ i18n.T(ctx, "about.source_label") }</dt>
			<dd><a href={ templ.URL(RepoURL) }>{ RepoURL }</a></dd>
			<dt>{ i18n.T(ctx, "about.license_label") }</dt>
			<dd>{ License }</dd>
			<dt>{ i18n.T(ctx, "about.authorship_label") }</dt>
			<dd>{ i18n.T(ctx, "about.authorship_text") }</dd>
		</dl>
	}
}

// BackLink is the "go up a level" link for a detail page reached from a
// list (a chat session from Chat, a lorebook from World) — the sidebar
// alone doesn't convey that relationship once you're inside one.
templ BackLink(href, label string) {
	<p class="back-link-bar"><a href={ templ.URL(href) } class="back-link">← { label }</a></p>
}

// Avatar renders a character card's or lorebook's image, or — when
// imagePath is "" (nothing uploaded yet) — a flat initial-letter
// fallback. Not the same as the chat page's "no lorebook image, pick a
// random placeholder" fallback (see pickRandomPlaceholder in
// handlers_chat.go): this one is deterministic, since a list row should
// look the same every time you load it, not shuffle on refresh.
templ Avatar(imagePath, name string) {
	if imagePath != "" {
		<img class="avatar" src={ imageSrc(imagePath) } alt={ name }/>
	} else {
		{{ initial := "" }}
		if len(name) > 0 {
			{{ initial = name[0:1] }}
		}
		<span class="avatar avatar-fallback" aria-hidden="true">{ initial }</span>
	}
}

// vignetteCard is one item in a Grid-view listing (World/Character) —
// a portrait rounded-corner card, the image filling it (or a flat
// fallback matching Avatar's own "no image yet" treatment, just
// bigger) and the name bolded over a bottom gradient so it stays
// legible against any image. href is wherever the row's own link
// normally goes (the lorebook or character edit page); deleteAction
// is the same POST target the List view's "Delete" row already uses
// — the <a> and the delete <form> are siblings (not nested — a form
// inside an anchor is invalid HTML) so the trash icon stays clickable
// on top of the full-card link underneath it.
//
// vaultAction is the item's /vault/{kind}/{id}/in route — the top-
// center padlock. These grids only ever list non-vaulted items, so it
// only ever means "hide this one", never a toggle.
templ vignetteCard(href, imagePath, name, deleteAction, vaultAction string, chatCount, vaultedCount int) {
	<div class="vignette-card" data-search-name={ name }>
		<a href={ templ.URL(href) } class="vignette-card-link">
			@vignetteFace(imagePath, name)
		</a>
		@chatCountBadge(chatCount, vaultedCount)
		<form method="post" action={ templ.URL(vaultAction) } class="vignette-vault">
			<button type="submit" aria-label={ fmt.Sprintf(i18n.T(ctx, "common.hide_into_vault"), name) } title={ fmt.Sprintf(i18n.T(ctx, "common.hide_into_vault"), name) }>
				<span aria-hidden="true">@navIcon("vault")</span>
			</button>
		</form>
		<form method="post" action={ templ.URL(deleteAction) } class="vignette-delete">
			<button type="submit" aria-label={ fmt.Sprintf(i18n.T(ctx, "common.delete_label"), name) } title={ fmt.Sprintf(i18n.T(ctx, "common.delete_label"), name) }>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 7h16"></path>
					<path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"></path>
					<path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path>
					<path d="M10 11v6"></path>
					<path d="M14 11v6"></path>
				</svg>
			</button>
		</form>
	</div>
}

// vignetteFace is a vignette's visible content — portrait image (or
// initial-letter fallback) plus the bottom name label — shared by
// vignetteCard (inside an <a>) and characterPickerStrip (inside a
// toggle <button>). Spans only, no <div>: a <button> only allows
// phrasing content, and .vignette-image is absolutely positioned so
// the element's own display type doesn't matter.
templ vignetteFace(imagePath, name string) {
	if imagePath != "" {
		<img class="vignette-image" src={ imageSrc(imagePath) } alt=""/>
	} else {
		{{ initial := "" }}
		if len(name) > 0 {
			{{ initial = name[0:1] }}
		}
		<span class="vignette-image vignette-fallback" aria-hidden="true">{ initial }</span>
	}
	<span class="vignette-label">{ name }</span>
}

// viewToggle is the List/Grid switch sitting above a list page's own
// content — viewKey must be unique per page ("world", "character")
// since the choice is remembered in localStorage per key, not
// globally (Lord might want one page as a grid and the other as a
// list). The panel it switches to is whatever the caller wraps in
// data-view-panel="list"/"grid" right after it, inside the same
// data-view-key container. One button, not two: it shows the glyph
// for the CURRENT view and a tap flips to the other — Lord's call,
// to save space in the header's action row and because two buttons
// side by side (one always "active"-styled) read as if World and
// Character responded differently when really it was just each
// page's own independently-remembered last choice. Grid is the
// default (viewToggleScript's own fallback agrees), so the glyph
// starts on ⊞.
templ viewToggle(viewKey string) {
	<button type="button" class="view-toggle-btn" data-view-key={ viewKey } data-label-grid={ i18n.T(ctx, "common.view_grid") } data-label-list={ i18n.T(ctx, "common.view_list") } aria-label={ i18n.T(ctx, "common.view_grid") } title={ i18n.T(ctx, "common.view_grid") }>⊞</button>
}

// viewToggleScript wires up every [data-view-key] button on the
// page: a click shows the matching [data-view-panel] and hides the
// other, remembers the choice in localStorage (keyed by data-view-key)
// so a reload doesn't reset it back to Grid (the default), and swaps
// the button's own glyph/label to match whichever view is now active
// — panels are looked up document-wide rather than via a shared
// parent since the toggle lives inside the page header, not directly
// above the panels it switches.
templ viewToggleScript() {
	<script>
		document.querySelectorAll("[data-view-key]").forEach(function (toggle) {
			var key = "aivalon-view-" + toggle.dataset.viewKey;
			var GLYPH = { grid: "⊞", list: "☰" };
			var LABEL = { grid: toggle.dataset.labelGrid, list: toggle.dataset.labelList };
			function apply(view) {
				document.querySelectorAll("[data-view-panel]").forEach(function (panel) {
					panel.hidden = panel.dataset.viewPanel !== view;
				});
				toggle.textContent = GLYPH[view];
				toggle.setAttribute("aria-label", LABEL[view]);
				toggle.setAttribute("title", LABEL[view]);
				toggle.dataset.view = view;
				// Mirrored into a cookie so the server can size the
				// page to the view (24 cards per Grid page, 50 rows per
				// List page — see viewPageSize in pagination.go).
				document.cookie = key + "=" + view + "; path=/; max-age=31536000; SameSite=Lax";
			}
			apply(localStorage.getItem(key) || "grid");
			toggle.addEventListener("click", function () {
				var next = toggle.dataset.view === "grid" ? "list" : "grid";
				localStorage.setItem(key, next);
				apply(next);
			});
		});
	</script>
}

// ImageField is the "Image" part of a character/lorebook create-or-edit
// form: a collapsible <details> (closed by default on create, since
// there's nothing to show yet) holding the current image at full modal
// width — not the tiny list-row Avatar — plus the file input to replace
// it. Lord's own ask: see it bigger, tucked away so it doesn't eat the
// modal's height when you're not looking at it.
templ ImageField(imagePath, name string) {
	<details open?={ imagePath != "" }>
		<summary>{ i18n.T(ctx, "common.image_label") }</summary>
		if imagePath != "" {
			<img class="image-field-preview" src={ imageSrc(imagePath) } alt={ name }/>
		}
		<input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp"/>
	</details>
}

// MenuAction is one row of a per-item OptionsMenu (see below): either a
// plain navigation link (Href set) or a POST action (Action set) —
// never both. Danger marks it for the same red-on-hover treatment as
// the old standalone Delete buttons.
type MenuAction struct {
	Label  string
	Href   string
	Action string
	Danger bool
}

// OptionsMenu is the "⋮" dropdown that replaced every row's separate
// Edit/Delete/Open buttons — Lord's call, for consistency across
// Chat/World/Character/Settings rather than a different action layout
// per list. menuID must be unique on the page (e.g.
// fmt.Sprintf("options-chat-%d", s.ID)) since toggleOptionsMenu
// (Layout's shared script) looks it up by id and closes every other
// one first.
templ OptionsMenu(menuID string, actions []MenuAction) {
	<div class="options-menu">
		<button type="button" class="options-trigger" aria-label="Options" aria-haspopup="true" aria-expanded="false" aria-controls={ menuID } data-menu-id={ menuID } onclick="toggleOptionsMenu(this.dataset.menuId)">⋮</button>
		<div id={ menuID } class="options-dropdown" role="menu" hidden>
			for _, a := range actions {
				if a.Href != "" {
					<a href={ templ.URL(a.Href) } role="menuitem">{ a.Label }</a>
				} else if a.Danger {
					<form method="post" action={ templ.URL(a.Action) }>
						<button type="submit" class="danger" role="menuitem">{ a.Label }</button>
					</form>
				} else {
					<form method="post" action={ templ.URL(a.Action) }>
						<button type="submit" role="menuitem">{ a.Label }</button>
					</form>
				}
			}
		</div>
	</div>
}

// PageHeaderWithCreate is Chat's own title row: heading on the left,
// the round "+" on the right. (The Vault used to sit here as a 🔒
// link; it's its own sidebar entry now.)
// PageHeaderWithCreate's title is already a translated string from the
// caller — see the same note on PageHeaderWithViewAndCreate below.
templ PageHeaderWithCreate(title, modalID, label string) {
	<div class="page-header">
		<h1>{ title }</h1>
		<div class="page-header-actions">
			<button type="button" class="create-button" aria-label={ label } title={ label } data-modal-id={ modalID } onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')">+</button>
		</div>
	</div>
}

// PageHeaderWithViewAndCreate is World/Character's title row: heading
// on the left, then — grouped together on the right, 20px apart per
// Lord's layout — the import "⤓" trigger, the List/Grid view switch,
// and the round "+" create button (see ImportButton/ImportModal,
// viewToggle/viewToggleScript for those two pieces themselves).
// importModalID must be unique per page since World and Character
// each get their own <dialog>.
templ PageHeaderWithViewAndCreate(title, viewKey, importModalID, modalID, label string) {
	<div class="page-header">
		<h1>{ title }</h1>
		<div class="page-header-actions">
			<button type="button" class="import-trigger" aria-label={ i18n.T(ctx, "common.import_trigger_label") } title={ i18n.T(ctx, "common.import_trigger_label") } data-modal-id={ importModalID } onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')">⤓</button>
			@viewToggle(viewKey)
			<button type="button" class="create-button" aria-label={ label } title={ label } data-modal-id={ modalID } onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')">+</button>
		</div>
	</div>
}

// tabsScript defines switchTabs(button) once, shared by every
// .tabs-based UI in the app (Settings' own three tabs, ImportModal's
// two) — plain [hidden] + aria-selected toggling, scoped to the
// button's own closest ".tabs" ancestor so two independent tab
// groups on the same page (unlikely today, but cheap to keep correct)
// don't cross-toggle each other's panels.
// tabsScript has no literal user-visible text of its own — only pure
// toggling logic — so there's nothing to translate here.
templ tabsScript() {
	<script>
		function switchTabs(button) {
			var target = button.dataset.tabTarget;
			button.parentElement.querySelectorAll(".tab-btn").forEach(function (btn) {
				btn.setAttribute("aria-selected", String(btn === button));
			});
			button.closest(".tabs").querySelectorAll("[data-tab-panel]").forEach(function (panel) {
				panel.hidden = panel.dataset.tabPanel !== target;
			});
		}
	</script>
}

// ImportModal is the dialog PageHeaderWithViewAndCreate's "⤓" trigger
// opens — two tabs sharing one destination: "From your Computer" is
// the plain file input (JSON or a Character Card PNG, same as
// before), "From URL" posts a direct link instead and
// handlers_import.go's readUploadOrURL fetches it server-side. Both
// tabs post to the same action, so the cross-import confirmation and
// every other bit of handlers_import.go's pipeline apply identically
// regardless of which tab was used.
//
// vaulted mirrors characterCardForm/lorebookCreateModal's own "vault"
// field — the Vault page's Characters/Worlds tabs reuse this exact
// dialog (their own instance, own modalID) with vaulted=true so
// whatever gets imported lands already hidden, same as their "+".
templ ImportModal(modalID, action string, vaulted bool) {
	<dialog id={ modalID }>
		<article>
			<header>
				<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
				<strong>{ i18n.T(ctx, "common.import") }</strong>
			</header>
			<div class="tabs">
				<div role="tablist" class="tab-list">
					<button type="button" role="tab" class="tab-btn" data-tab-target="computer" aria-selected="true" onclick="switchTabs(this)">{ i18n.T(ctx, "common.import_from_computer") }</button>
					<button type="button" role="tab" class="tab-btn" data-tab-target="url" aria-selected="false" onclick="switchTabs(this)">{ i18n.T(ctx, "common.import_from_url") }</button>
				</div>
				<div data-tab-panel="computer">
					<form method="post" action={ templ.URL(action) } enctype="multipart/form-data">
						if vaulted {
							<input type="hidden" name="vault" value="1"/>
						}
						<input type="file" name="file" accept=".json,application/json,.png,image/png" multiple="multiple" required="required"/>
						<button type="submit">{ i18n.T(ctx, "common.import") }</button>
					</form>
				</div>
				<div data-tab-panel="url" hidden="hidden">
					<form method="post" action={ templ.URL(action) }>
						if vaulted {
							<input type="hidden" name="vault" value="1"/>
						}
						<label>
							{ i18n.T(ctx, "common.import_url_label") }
							<input type="url" name="url" placeholder={ i18n.T(ctx, "common.import_url_placeholder") } required="required"/>
							<small>{ i18n.T(ctx, "common.import_url_helper") }</small>
						</label>
						<button type="submit">{ i18n.T(ctx, "common.import") }</button>
					</form>
				</div>
			</div>
		</article>
	</dialog>
}

// Page composes the layout with a placeholder body for a given section.
// Each section gets its own real component once its feature lands; this is
// what the four routes render today.
templ Page(title string, active string) {
	@Layout(title, active) {
		@Placeholder(active)
	}
}

// pagerNav is the Prev / "Page N of M" / Next row under every
// server-side-paginated list (see Pager, pagination.go). Renders
// nothing when everything fits on one page. Empty spans hold Prev/Next's
// slots on the first/last page so the status text doesn't jump sideways.
templ pagerNav(p Pager) {
	if p.TotalPages > 1 {
		<nav class="pager" aria-label={ i18n.T(ctx, "common.pager_aria_label") }>
			if p.Page > 1 {
				<a href={ templ.URL(p.Href(p.Page - 1)) } rel="prev">{ i18n.T(ctx, "common.pager_prev") }</a>
			} else {
				<span></span>
			}
			<span class="pager-status">{ fmt.Sprintf(i18n.T(ctx, "common.pager_status"), p.Page, p.TotalPages) }</span>
			if p.Page < p.TotalPages {
				<a href={ templ.URL(p.Href(p.Page + 1)) } rel="next">{ i18n.T(ctx, "common.pager_next") }</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

// searchFilterInput is the instant name filter above a list page's
// content (Chat, World, Character). key pairs it with the matching
// data-search-scope container; every filterable item inside that
// container carries data-search-name (vignetteCard does it itself;
// table rows / list items set it inline). One input per page, not one
// per Grid/List panel: both panels render the same items, so filtering
// both at once keeps them in sync by construction. See
// searchFilterScript for the behavior.
templ searchFilterInput(key string) {
	<input type="search" class="search-filter" data-search-key={ key } placeholder={ i18n.T(ctx, "common.filter_placeholder") } aria-label={ i18n.T(ctx, "common.filter_aria_label") } autocomplete="off"/>
	<p class="search-no-matches" data-search-empty={ key } role="status" hidden><em>{ i18n.T(ctx, "common.no_matches") }</em></p>
}

// searchFilterScript wires every searchFilterInput on the page:
// case-insensitive substring match against each item's
// data-search-name, hiding non-matches via [hidden].
//
// Page-local by design (v1): pagination is server-side, so this only
// filters the items on the page currently loaded — the "No matches"
// text says "on this page" for exactly that reason. A cross-page search
// would need a server-side ?q= on the List queries instead.
templ searchFilterScript() {
	<script>
		document.querySelectorAll("input[data-search-key]").forEach(function (input) {
			var key = input.dataset.searchKey;
			var empty = document.querySelector('[data-search-empty="' + key + '"]');
			function apply() {
				var q = input.value.trim().toLowerCase();
				var items = document.querySelectorAll('[data-search-scope="' + key + '"] [data-search-name]');
				var shown = 0;
				items.forEach(function (item) {
					var match = item.dataset.searchName.toLowerCase().indexOf(q) !== -1;
					item.hidden = !match;
					if (match) {
						shown++;
					}
				});
				if (empty) {
					empty.hidden = !(items.length > 0 && shown === 0);
				}
			}
			input.addEventListener("input", apply);
			// A browser restoring the field's text on Back must also
			// restore the filtering it implies.
			if (input.value) {
				apply();
			}
		});
	</script>
}

// DeleteConfirmPage is what a Delete POST renders instead of deleting
// when the persona/lorebook/character is still used by chats — same
// <dialog open><article> shape as every other modal here, just served
// as its own page so the plain no-JS delete forms need no changes.
// "Delete anyway" re-posts with confirm=1; Cancel just goes back.
// Vaulted chats are listed but never by title (the Vault stays secret).
templ DeleteConfirmPage(active, name, action, cancelHref string, sessions []db.SessionRef) {
	@Layout(fmt.Sprintf(i18n.T(ctx, "common.delete_label"), name), active) {
		<dialog
			open
			data-cancel-href={ cancelHref }
			onclick="if(event.target===this){location.href=this.dataset.cancelHref}"
		>
			<article>
				<header>
					<a href={ templ.URL(cancelHref) } aria-label={ i18n.T(ctx, "common.close") } rel="prev"></a>
					<strong>{ fmt.Sprintf(i18n.T(ctx, "common.delete_confirm_title"), name) }</strong>
				</header>
				<p>
					{ fmt.Sprintf(i18n.T(ctx, "common.delete_used_by"), name, len(sessions)) }
					<strong class="danger-text">{ i18n.T(ctx, "common.delete_warning") }</strong>
				</p>
				<ul>
					for _, s := range sessions {
						if s.IsVaulted {
							<li><em>{ i18n.T(ctx, "common.delete_hidden_chat") }</em></li>
						} else if s.Title == "" {
							<li><em>{ i18n.T(ctx, "common.delete_untitled_chat") }</em></li>
						} else {
							<li>{ s.Title }</li>
						}
					}
				</ul>
				<footer class="delete-confirm-footer">
					<button type="button" class="secondary" data-cancel-href={ cancelHref } onclick="location.href=this.dataset.cancelHref">{ i18n.T(ctx, "common.cancel") }</button>
					<form method="post" action={ templ.URL(action) } class="inline-form">
						<input type="hidden" name="confirm" value="1"/>
						<button type="submit" class="button-danger">{ i18n.T(ctx, "common.delete_anyway") }</button>
					</form>
				</footer>
			</article>
		</dialog>
	}
}

// chatCountBadge is the vignette's top-left "x y" marker: x = visible
// chats using the item, y = vaulted ones. The two pills swap gold and
// tertiary on purpose, so which number is which reads from the colors,
// not just position. Nothing at all for an unused item.
templ chatCountBadge(visible, vaulted int) {
	if visible+vaulted > 0 {
		<span class="chat-count-badge" title={ fmt.Sprintf(i18n.T(ctx, "common.chat_count_tooltip"), visible, vaulted) }>
			<span class="chat-count-visible">{ fmt.Sprintf("%d", visible) }</span>
			{ " " }
			<span class="chat-count-vaulted">{ fmt.Sprintf("%d", vaulted) }</span>
		</span>
	}
}

// vaultMarker is the non-interactive "this one's in the vault" badge
// (same padlock as the sidebar's Vault icon) — see sessionModal.
templ vaultMarker() {
	<span class="vault-marker" role="img" aria-label={ i18n.T(ctx, "common.in_vault") } title={ i18n.T(ctx, "common.in_vault") }>@navIcon("vault")</span>
}
