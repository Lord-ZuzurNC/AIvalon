package web

import (
	"fmt"
	"strings"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

// truncate shortens s to at most n runes (so a multi-byte UTF-8
// character never gets split mid-sequence), appending "…" when it had
// to cut. Used for the character list's Description column — a card's
// bio can run to several paragraphs, far too long for a table cell.
func truncate(s string, n int) string {
	r := []rune(s)
	if len(r) <= n {
		return s
	}
	return strings.TrimRight(string(r[:n]), " ") + "…"
}

templ CharacterPage(cards []db.CharacterCard, editing *db.CharacterCard, editingImages []db.CharacterCardImage) {
	@Layout("Character", "Character") {
		@PageHeaderWithViewAndCreate("Character", "character", "character-import-modal", "character-modal", "Add a character")
		if len(cards) == 0 {
			<p><em>No characters yet — add one above. A session with none picked runs as a free-form world/GM instead.</em></p>
		} else {
			<div data-view-panel="grid" class="card-grid">
				for _, c := range cards {
					@vignetteCard(fmt.Sprintf("/characters/%d/edit", c.ID), c.ImagePath, c.Name, fmt.Sprintf("/characters/%d/delete", c.ID))
				}
			</div>
			<div data-view-panel="list" hidden="hidden">
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range cards {
							<tr>
								<td>@Avatar(c.ImagePath, c.Name)<a href={ templ.URL(fmt.Sprintf("/characters/%d/edit", c.ID)) }>{ c.Name }</a></td>
								<td>{ truncate(c.Description, 120) }</td>
								<td>
									@OptionsMenu(fmt.Sprintf("options-character-%d", c.ID), []MenuAction{
										{Label: "Delete", Action: fmt.Sprintf("/characters/%d/delete", c.ID), Danger: true},
									})
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@viewToggleScript()
		}

		<dialog id="character-modal" open?={ editing != nil }>
			<article>
				<header>
					<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
					<strong>
						if editing != nil {
							Edit character
						} else {
							Add a character
						}
					</strong>
				</header>
				@characterCardForm(editing)
				if editing != nil {
					@characterImageGallery(editing.ID, editing.ImagePath, editingImages)
				}
			</article>
		</dialog>
		@ImportModal("character-import-modal", "/characters/import")
		@tabsScript()
	}
}

// characterImageGallery lists every secondary image on this character
// card alongside the current primary — "Make primary" swaps the
// pointer (see db.SetPrimaryCharacterCardImage), "Delete" removes the
// row outright. The primary image itself has neither button: it's
// already what ImageField above shows as the main portrait, and
// deleting your only image from here instead of via a fresh upload
// would leave the card pointing at nothing without an obvious way back.
// otherImageCount counts images that aren't the current primary —
// what characterImageGallery's loop actually renders. images itself
// includes the primary (it's "every image on the card", not just the
// secondaries), so len(images) overcounts by exactly one whenever a
// primary is set: "Other images (1)" with nothing inside the
// gallery to show for it.
func otherImageCount(images []db.CharacterCardImage, primaryPath string) int {
	n := 0
	for _, img := range images {
		if img.ImagePath != primaryPath {
			n++
		}
	}
	return n
}

templ characterImageGallery(characterID int64, primaryPath string, images []db.CharacterCardImage) {
	<details>
		<summary>Other images ({ fmt.Sprintf("%d", otherImageCount(images, primaryPath)) })</summary>
		if otherImageCount(images, primaryPath) == 0 {
			<p><em>No other images yet — upload one above; it joins the gallery here until you make it primary.</em></p>
		} else {
			<div class="image-gallery">
				for _, img := range images {
					if img.ImagePath != primaryPath {
						<div class="image-gallery-item">
							<img src={ "/static/" + img.ImagePath } alt="Character image"/>
							<form method="post" action={ templ.URL(fmt.Sprintf("/characters/%d/images/%d/primary", characterID, img.ID)) }>
								<button type="submit">Make primary</button>
							</form>
							<form method="post" action={ templ.URL(fmt.Sprintf("/characters/%d/images/%d/delete", characterID, img.ID)) }>
								<button type="submit" class="danger">Delete</button>
							</form>
						</div>
					}
				}
			</div>
		}
	</details>
}

templ characterCardForm(editing *db.CharacterCard) {
	{{
	action := "/characters"
	c := db.CharacterCard{}
	if editing != nil {
		action = fmt.Sprintf("/characters/%d", editing.ID)
		c = *editing
	}
	}}
	<form method="post" action={ templ.URL(action) } enctype="multipart/form-data">
		@ImageField(c.ImagePath, c.Name)
		<label>
			Name
			<input type="text" name="name" value={ c.Name } required="required"/>
		</label>
		<label>
			Description
			<textarea name="description">{ c.Description }</textarea>
		</label>
		<label>
			Personality
			<textarea name="personality">{ c.Personality }</textarea>
		</label>
		<label>
			Scenario
			<textarea name="scenario">{ c.Scenario }</textarea>
		</label>
		<label>
			First message
			<textarea name="first_message">{ c.FirstMessage }</textarea>
		</label>
		<label>
			Example messages
			<textarea name="example_messages">{ c.ExampleMessages }</textarea>
		</label>
		<label>
			Author's note (optional — tips from whoever wrote this character: intended model, how to run them, etc.)
			<textarea name="author_note">{ c.AuthorNote }</textarea>
		</label>
		<button type="submit">
			if editing != nil {
				Save
			} else {
				Add character
			}
		</button>
	</form>
}
