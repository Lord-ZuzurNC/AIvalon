package web

import "fmt"

// vaultPinHashScript hashes a PIN client-side (SHA-256 of salt+pin via
// the Web Crypto API) before any <form class="pin-form"> on the page
// ever submits — so a glance at the browser's own DevTools Network tab
// during unlock shows a hash, not the raw digits (Lord caught this: the
// payload used to carry "pin: 564546" in the clear). The salt itself
// isn't secret — it's embedded in the page precisely so the client can
// reproduce the same hash the server stored — only the PIN is.
// Each pin-form needs: a hidden input[name=salt] (the salt to hash
// with), one or more visible input[data-pin][data-hash-field=X], and a
// matching hidden input[name=X] to receive the hex digest. An optional
// hidden input[name=digits] gets the first PIN field's length (purely
// informational — see db.VaultPIN.Digits — never a security boundary,
// since nothing server-side actually gates on it).
templ vaultPinHashScript() {
	<script>
		async function aivalonSha256Hex(text) {
			var buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
			return Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, "0"); }).join("");
		}
		document.querySelectorAll("form.pin-form").forEach(function (form) {
			form.addEventListener("submit", async function (e) {
				e.preventDefault();
				var salt = form.querySelector('input[name="salt"]').value;
				var pinInputs = form.querySelectorAll("input[data-pin]");
				var firstLen = pinInputs.length ? pinInputs[0].value.length : 0;
				for (var i = 0; i < pinInputs.length; i++) {
					var pinInput = pinInputs[i];
					var hashField = form.querySelector('input[name="' + pinInput.dataset.hashField + '"]');
					hashField.value = await aivalonSha256Hex(salt + pinInput.value);
					pinInput.value = "";
					pinInput.removeAttribute("name");
				}
				var digitsField = form.querySelector('input[name="digits"]');
				if (digitsField) {
					digitsField.value = String(firstLen);
				}
				// Mark the enclosing dialog (if any) as "really
				// submitting" before handing off to the real POST —
				// so the dialog's own "close" listener (see
				// pinPadScript) can tell a genuine submit apart from
				// a cancel/backdrop-click/Escape dismissal, which is
				// what should redirect away (see data-cancel-redirect).
				var dialog = form.closest("dialog");
				if (dialog) {
					dialog.dataset.submitted = "true";
				}
				form.submit();
			});
		});
	</script>
}

// pinPadScript wires up every ".pin-pad" numeric keypad on the page:
// digit/backspace/clear buttons write into that pad's own hidden
// input[data-pin] (dispatching a real "input" event so typing and
// clicking are indistinguishable to any other listener — including
// vaultPinHashScript above), and a per-pad random shape — one of five
// soft/rounded icons, assigned once per keystroke and free to repeat
// or recur back-to-back — stands in for the usual "•" per digit typed.
// Physical keyboard input keeps working throughout: the real input
// stays focused (digit clicks refocus it immediately after writing),
// so "use the pad" and "type on the keyboard" are just two ways of
// changing the same value, never a choice the markup has to branch on.
//
// It also owns every ".pin-pad-modal" dialog's open/close behavior:
// dialogs marked data-autoopen="true" pop open via showModal() as soon
// as the script runs (VaultUnlockPage's dialog is the whole point of
// that page, and a re-rendered Unhide dialog after a wrong PIN needs
// to come back up already open rather than making Lord re-click
// "Unhide"); clicking the backdrop closes a dialog the same as
// pressing Escape already does natively; and closing *without* having
// actually submitted (tracked by vaultPinHashScript's submit handler
// above) sends the browser to data-cancel-redirect if the dialog has
// one — Lord's bug report: dismissing the Unlock pad without entering
// a PIN used to strand him on a near-empty "Vault" page instead of
// going back to Chat.
templ pinPadScript() {
	<script>
		(function () {
			var SHAPES = {
				circle: '<circle cx="12" cy="12" r="8.5"/>',
				square: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/>',
				triangle: '<polygon points="12,3.5 20.5,19.5 3.5,19.5" stroke-linejoin="round" stroke-width="1" stroke="currentColor"/>',
				heart: '<path d="M12 19.5s-7.3-4.4-9.3-8.7C1.3 7.6 3 4.5 6.2 4.5c2 0 3.4 1.1 5.8 4 2.4-2.9 3.8-4 5.8-4 3.2 0 4.9 3.1 3.5 6.3-2 4.3-9.3 8.7-9.3 8.7z"/>',
				hexagon: '<polygon points="12,3.5 19.8,8 19.8,16.5 12,21 4.2,16.5 4.2,8" stroke-linejoin="round" stroke-width="1" stroke="currentColor"/>',
			};
			var NAMES = Object.keys(SHAPES);

			function renderShapes(pad) {
				var input = pad.querySelector("input[data-pin]");
				var tray = pad.querySelector(".pin-shapes");
				if (!input || !tray) {
					return;
				}
				var len = input.value.length;
				while (pad._pinShapeNames.length < len) {
					pad._pinShapeNames.push(NAMES[Math.floor(Math.random() * NAMES.length)]);
				}
				pad._pinShapeNames.length = len;
				tray.innerHTML = pad._pinShapeNames.map(function (name) {
					return '<svg class="pin-shape" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">' + SHAPES[name] + "</svg>";
				}).join("");
			}

			document.querySelectorAll(".pin-pad").forEach(function (pad) {
				pad._pinShapeNames = [];
				var input = pad.querySelector("input[data-pin]");
				if (!input) {
					return;
				}
				var maxLen = parseInt(pad.dataset.maxLen || "8", 10);
				input.addEventListener("input", function () {
					renderShapes(pad);
				});
				pad.querySelectorAll("button[data-digit]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						if (input.value.length >= maxLen) {
							return;
						}
						input.value += btn.dataset.digit;
						input.dispatchEvent(new Event("input", { bubbles: true }));
						input.focus();
					});
				});
				var backspace = pad.querySelector(".pin-pad-backspace");
				if (backspace) {
					backspace.addEventListener("click", function () {
						input.value = input.value.slice(0, -1);
						input.dispatchEvent(new Event("input", { bubbles: true }));
						input.focus();
					});
				}
			});

			document.querySelectorAll("[data-open-dialog]").forEach(function (btn) {
				btn.addEventListener("click", function () {
					var dialog = document.getElementById(btn.dataset.openDialog);
					if (dialog) {
						dialog.showModal();
					}
				});
			});
			document.querySelectorAll("[data-close-dialog]").forEach(function (btn) {
				btn.addEventListener("click", function () {
					var dialog = btn.closest("dialog");
					if (dialog) {
						dialog.close();
					}
				});
			});

			document.querySelectorAll("dialog.pin-pad-modal").forEach(function (dialog) {
				if (dialog.dataset.autoopen === "true" && !dialog.open) {
					dialog.showModal();
				}
				dialog.addEventListener("click", function (e) {
					if (e.target === dialog) {
						dialog.close();
					}
				});
				dialog.addEventListener("close", function () {
					if (dialog.dataset.cancelRedirect && dialog.dataset.submitted !== "true") {
						window.location.href = dialog.dataset.cancelRedirect;
					}
				});
			});
		})();
	</script>
}

// pinPad renders a numeric keypad (1-9 in a 3x3 grid, then backspace /
// 0 / validate — the validate button always ends up bottom-right, per
// Lord's spec) plus the shape tray above it, wrapping a real
// password-type input[data-pin] that stays in the DOM so keyboard
// typing works alongside pad clicks (see pinPadScript). dialogID is
// used by callers that open this pad inside a <dialog> they control
// themselves (the vault list's per-session "Unhide" pads); pass ""
// when the pad is the only thing on the page (Unlock) and doesn't
// need a close button. errMsg renders inside the pad (and so inside
// the enclosing <dialog>) — a <dialog> is in the browser's "top
// layer" once opened via showModal(), so an error message left
// outside it in the normal page flow ends up visually underneath it;
// Lord caught "Wrong PIN" going invisible that way.
templ pinPad(hashField, placeholder, dialogID, errMsg string) {
	<div class="pin-pad" data-max-len="8">
		if errMsg != "" {
			<p class="danger-text">{ errMsg }</p>
		}
		<div class="pin-shapes" aria-hidden="true"></div>
		<input
			type="password"
			inputmode="numeric"
			pattern="[0-9]*"
			data-pin
			data-hash-field={ hashField }
			autocomplete="current-password"
			autofocus="autofocus"
			required="required"
			class="pin-pad-real-input"
			aria-label={ placeholder }
		/>
		<div class="pin-pad-grid">
			for _, d := range []string{"1", "2", "3", "4", "5", "6", "7", "8", "9"} {
				<button type="button" data-digit={ d }>{ d }</button>
			}
			<button type="button" class="pin-pad-backspace" aria-label="Backspace">⌫</button>
			<button type="button" data-digit="0">0</button>
			<button type="submit" class="pin-pad-validate" aria-label="Validate">✓</button>
		</div>
		if dialogID != "" {
			<button type="button" class="pin-pad-cancel" data-close-dialog="true">Cancel</button>
		}
	</div>
}

// lockIcon is a small closed-padlock SVG, colored like the app's other
// destructive/guarded actions (the same red as .danger buttons) — sits
// next to the "Vault" heading as the "lock it back up now" button,
// replacing the old plain "Lock vault now" text button.
templ lockIcon() {
	<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
		<path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm0 2a3 3 0 0 1 3 3v3H9V7a3 3 0 0 1 3-3zm0 10a1.75 1.75 0 0 1 1 3.2V19a1 1 0 1 1-2 0v-1.8A1.75 1.75 0 0 1 12 14z"/>
	</svg>
}

// trashIcon mirrors vignetteCard's own delete-button SVG (same outline
// shape, same stroke="currentColor" convention) — kept as its own
// component here since the Vault list's row actions (see
// VaultListPageWithError) need the exact same icon on a plain
// <button>, not the vignette grid's absolutely-positioned corner.
templ trashIcon() {
	<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M4 7h16"></path>
		<path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"></path>
		<path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path>
		<path d="M10 11v6"></path>
		<path d="M14 11v6"></path>
	</svg>
}

// eyeIcon is the Vault list's "Unhide" trigger (replacing the old
// plain text button) — an open eye, same outline convention as every
// other authored icon here. Gold (.icon-btn-gold) rather than the red
// lockIcon/trashIcon use: revealing something isn't a guarded/
// destructive action the way locking or deleting is.
templ eyeIcon() {
	<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
		<circle cx="12" cy="12" r="3"></circle>
	</svg>
}

templ VaultSetupPage(errMsg, salt string) {
	@Layout("Vault", "Vault") {
		<h1>Vault</h1>
		<p>No PIN set yet — choose one to start keeping sessions here. You'll need to retype it every time you take a session back <em>out</em> of the vault.</p>
		if errMsg != "" {
			<p class="danger-text">{ errMsg }</p>
		}
		<form method="post" action="/vault/setup" class="pin-form">
			<input type="hidden" name="salt" value={ salt }/>
			<input type="hidden" name="pin_hash"/>
			<input type="hidden" name="confirm_hash"/>
			<input type="hidden" name="digits"/>
			<label>
				PIN (4, 6, or 8 digits)
				<input type="password" inputmode="numeric" pattern="[0-9]*" data-pin data-hash-field="pin_hash" autocomplete="new-password" required="required"/>
			</label>
			<label>
				Confirm PIN
				<input type="password" inputmode="numeric" pattern="[0-9]*" data-pin data-hash-field="confirm_hash" autocomplete="new-password" required="required"/>
			</label>
			<button type="submit">Set PIN</button>
		</form>
		@vaultPinHashScript()
	}
}

templ VaultUnlockPage(errMsg, salt string) {
	@Layout("Vault", "Vault") {
		<h1>Vault</h1>
		<dialog class="pin-pad-modal" data-autoopen="true" data-cancel-redirect="/chat">
			<form method="post" action="/vault/unlock" class="pin-form">
				<input type="hidden" name="salt" value={ salt }/>
				<input type="hidden" name="pin_hash"/>
				@pinPad("pin_hash", "PIN", "", errMsg)
			</form>
		</dialog>
		@vaultPinHashScript()
		@pinPadScript()
	}
}

templ VaultListPage(v VaultContents, salt string) {
	@VaultListPageWithError(v, salt, "", "", "", 0)
}

// vaultItem is one row of a Vault tab, whatever its kind.
type vaultItem struct {
	ID         int64
	Title      string
	Href       string
	DeleteHref string
}

// vaultTab is one of the Vault page's three tabs; Kind is also the
// {kind} segment of its /vault/{kind}/{id}/out route.
// Create is the id of the dialog its "+" opens ("" = no "+", the
// Chats tab with no backend profile to start a session on yet).
// Import is the id of the dialog its "⤓" opens ("" = no import —
// only Characters/Worlds get one; a session isn't a file you import).
type vaultTab struct {
	Kind, Label, Noun, Empty, Create, Import string
	Items                                    []vaultItem
}

func vaultTabs(v VaultContents) []vaultTab {
	tabs := []vaultTab{
		{Kind: "chats", Label: "Chats", Noun: "session", Empty: "Nothing in the vault — move a session here from its own options menu in Chats."},
		{Kind: "characters", Label: "Characters", Noun: "character", Empty: "No hidden characters — move one here from its options menu in Characters (list view)."},
		{Kind: "worlds", Label: "Worlds", Noun: "lorebook", Empty: "No hidden lorebooks — move one here from its options menu in Worlds (list view)."},
	}
	tabs[1].Create, tabs[2].Create = "character-modal", "lorebook-modal"
	tabs[1].Import, tabs[2].Import = "character-import-modal-vault", "lorebook-import-modal-vault"
	if len(v.Profiles) > 0 {
		tabs[0].Create = "session-modal"
	}
	for _, s := range v.Sessions {
		tabs[0].Items = append(tabs[0].Items, vaultItem{s.ID, s.Title, fmt.Sprintf("/chat/%d", s.ID), fmt.Sprintf("/chat/%d/delete", s.ID)})
	}
	for _, c := range v.Characters {
		tabs[1].Items = append(tabs[1].Items, vaultItem{c.ID, c.Name, fmt.Sprintf("/characters/%d/edit", c.ID), fmt.Sprintf("/characters/%d/delete", c.ID)})
	}
	for _, l := range v.Lorebooks {
		tabs[2].Items = append(tabs[2].Items, vaultItem{l.ID, l.Name, fmt.Sprintf("/world/%d", l.ID), fmt.Sprintf("/world/%d/delete", l.ID)})
	}
	return tabs
}

// activeTab picks the visible tab ("" = Chats); errKind+errID identify which item's own Unhide dialog a wrong-PIN
// retry belongs to (errKind "" means no error) — MoveOut re-renders
// this whole page on failure, so only *that* item's dialog gets
// reopened (data-autoopen) with the error message inside it, and its
// tab is the one shown (a dialog inside a [hidden] panel would open
// invisibly). The kind is part of the key because a character and a
// session can share the same numeric id.
templ VaultListPageWithError(v VaultContents, salt, activeTab, errMsg, errKind string, errID int64) {
	if activeTab == "" {
		{{ activeTab = "chats" }}
	}
	@Layout("Vault", "Vault") {
		<div class="vault-heading">
			<h1>Vault</h1>
			<form method="post" action="/vault/lock" class="vault-lock-form">
				<button type="submit" class="icon-btn" aria-label="Lock vault now" title="Lock vault now">
					@lockIcon()
				</button>
			</form>
		</div>
		<div class="tabs">
			<div role="tablist" class="tab-list">
				for _, t := range vaultTabs(v) {
					<button type="button" role="tab" class="tab-btn" data-tab-target={ t.Kind } aria-selected={ fmt.Sprintf("%t", activeTab == t.Kind) } onclick="switchTabs(this)">{ fmt.Sprintf("%s (%d)", t.Label, len(t.Items)) }</button>
				}
			</div>
			for _, t := range vaultTabs(v) {
				<div data-tab-panel={ t.Kind } role="tabpanel" hidden?={ activeTab != t.Kind }>
					if t.Create != "" || t.Import != "" {
						<div class="vault-tab-actions">
							if t.Import != "" {
								<button type="button" class="import-trigger" aria-label={ "Import a hidden " + t.Noun } title={ "Import a hidden " + t.Noun } data-modal-id={ t.Import } onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')">⤓</button>
							}
							if t.Create != "" {
								<button type="button" class="create-button" aria-label={ "New hidden " + t.Noun } title={ "New hidden " + t.Noun } data-modal-id={ t.Create } onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')">+</button>
							}
						</div>
					}
					if len(t.Items) == 0 {
						<p><em>{ t.Empty }</em></p>
					} else {
						<ul class="list-with-actions">
							for _, it := range t.Items {
								{{ dialogID := fmt.Sprintf("unhide-modal-%s-%d", t.Kind, it.ID) }}
								{{ isErrTarget := t.Kind == errKind && it.ID == errID }}
								<li>
									<a href={ templ.URL(it.Href) }>{ it.Title }</a>
									<div class="vault-item-actions">
										<button type="button" class="icon-btn icon-btn-gold" aria-label={ "Unhide " + it.Title } title={ "Unhide " + it.Title } data-open-dialog={ dialogID }>
											@eyeIcon()
										</button>
										<form method="post" action={ templ.URL(it.DeleteHref) }>
											<button type="submit" class="icon-btn" aria-label={ "Delete " + it.Title } title={ "Delete " + it.Title }>
												@trashIcon()
											</button>
										</form>
									</div>
									<dialog id={ dialogID } class="pin-pad-modal" data-autoopen={ fmt.Sprintf("%t", isErrTarget) }>
										<form method="post" action={ templ.URL(fmt.Sprintf("/vault/%s/%d/out", t.Kind, it.ID)) } class="vault-out-form pin-form">
											<input type="hidden" name="salt" value={ salt }/>
											<input type="hidden" name="pin_hash"/>
											if isErrTarget {
												@pinPad("pin_hash", "PIN to unhide this "+t.Noun, dialogID, errMsg)
											} else {
												@pinPad("pin_hash", "PIN to unhide this "+t.Noun, dialogID, "")
											}
										</form>
									</dialog>
								</li>
							}
						</ul>
					}
				</div>
			}
		</div>
		if len(v.Profiles) > 0 {
			@sessionModal(v.Profiles, v.Personas, v.PickCharacters, v.PickLorebooks, true)
		}
		<dialog id="character-modal">
			<article>
				<header>
					<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
					<strong>Add a hidden character</strong>
				</header>
				@characterCardForm(nil, true)
			</article>
		</dialog>
		@lorebookCreateModal(true)
		@ImportModal("character-import-modal-vault", "/characters/import", true)
		@ImportModal("lorebook-import-modal-vault", "/world/import", true)
		@tabsScript()
		@vaultPinHashScript()
		@pinPadScript()
	}
}
