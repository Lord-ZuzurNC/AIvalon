package web

import (
	"fmt"
	"strings"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

// MessageBlock renders one chat line plus its per-message actions in a
// "⋮" dropdown, top-right — consistent with the same pattern used for
// Chat/World/Character/Settings rows. It's used both from ChatPage's
// history loop and from the Stream handler's final SSE out-of-band swap
// (see handlers_chat.go) — that second use is why this is its own templ
// component and not inlined: a reply you just watched stream in needs
// the same Regenerate/Branch/Delete/Copy options as one loaded from
// history, without a page reload.
templ MessageBlock(sessionID int64, m DisplayMessage) {
	<div class={ "message", "message-" + m.Role } data-content={ m.Content }>
		<div class="message-header">
			<p>
				if m.Speaker != "" {
					<strong>{ m.Speaker }:</strong>
				}
				@templ.Raw(m.ContentHTML)
			</p>
			<div class="options-menu">
				<button type="button" class="options-trigger" aria-label="Message options" data-menu-id={ fmt.Sprintf("options-message-%d", m.ID) } onclick="toggleOptionsMenu(this.dataset.menuId)">⋮</button>
				<div id={ fmt.Sprintf("options-message-%d", m.ID) } class="options-dropdown" hidden>
					if m.Role == "user" {
						<button type="button" onclick="toggleEditForm(this)">Edit</button>
					} else {
						<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/regenerate", sessionID, m.ID)) }>
							<button type="submit">Regenerate</button>
						</form>
						<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/branch", sessionID, m.ID)) }>
							<button type="submit">Branch</button>
						</form>
					}
					<button type="button" onclick="copyMessageContent(this)">Copy</button>
					<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/delete", sessionID, m.ID)) }>
						<button type="submit" class="danger">Delete</button>
					</form>
				</div>
			</div>
		</div>
		if m.Role == "user" {
			<form class="message-edit-form" style="display:none" method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/edit", sessionID, m.ID)) }>
				<textarea name="content" rows="3">{ m.Content }</textarea>
				<button type="submit">Save &amp; regenerate</button>
			</form>
		}
	</div>
}

templ ChatListPage(sessions []db.Session, profiles []db.BackendProfile, personas []db.Persona, characters []db.CharacterCard, lorebooks []db.Lorebook) {
	@Layout("Chat", "Chat") {
		if len(profiles) == 0 {
			<div class="page-header">
				<h1>Chat</h1>
				<a href="/vault" class="vault-trigger" aria-label="Vault" title="Vault">🔒</a>
			</div>
		} else {
			@PageHeaderWithVaultAndCreate("Chat", "session-modal", "New session")
		}
		if len(sessions) == 0 {
			<p><em>No sessions yet — start one below.</em></p>
		} else {
			<ul class="list-with-actions">
				for _, s := range sessions {
					<li>
						<a href={ templ.URL(fmt.Sprintf("/chat/%d", s.ID)) }>{ s.Title }</a>
						@OptionsMenu(fmt.Sprintf("options-chat-%d", s.ID), []MenuAction{
							{Label: "Duplicate", Action: fmt.Sprintf("/chat/%d/duplicate", s.ID)},
							{Label: "Hide into vault", Action: fmt.Sprintf("/vault/%d/in", s.ID)},
							{Label: "Delete", Action: fmt.Sprintf("/chat/%d/delete", s.ID), Danger: true},
						})
					</li>
				}
			</ul>
		}
		if len(profiles) == 0 {
			<p>
				No backend profile yet —
				<a href="/settings">add one in Settings</a>
				first.
			</p>
		} else {
			<dialog id="session-modal">
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>New session</strong>
					</header>
					<form method="post" action="/chat">
						<label>
							Title
							<input type="text" name="title" placeholder="Untitled chat" value=""/>
						</label>
						<label>
							Backend profile
							<select name="backend_profile_id">
								for _, p := range profiles {
									<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
								}
							</select>
						</label>
						<label>
							Persona (optional — defaults to "User")
							<select name="persona_id">
								<option value="">(default)</option>
								for _, p := range personas {
									<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
								}
							</select>
						</label>
						<label>
							Characters (optional, select multiple for a group chat)
							<select name="character_ids" multiple="multiple">
								for _, c := range characters {
									<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
								}
							</select>
						</label>
						<label>
							Lorebook (optional — world info available to the narrator)
							<select name="lorebook_id">
								<option value="">(none)</option>
								for _, l := range lorebooks {
									<option value={ fmt.Sprintf("%d", l.ID) }>{ l.Name }</option>
								}
							</select>
						</label>
						<button type="submit">Start chat</button>
					</form>
				</article>
			</dialog>
		}
	}
}

// sendIcon/imageIcon are small authored line-art SVGs (same
// stroke="currentColor" convention as navIcon in templates.templ) for
// the two input-row actions — a paper plane for Send, a simple framed
// landscape for Generate image. Neither is a vendored icon font or
// emoji.
templ sendIcon() {
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M3 11l18-8-8 18-2.5-7.5L3 11z"></path>
	</svg>
}

templ imageIcon() {
	<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<circle cx="9" cy="10" r="1.6" fill="currentColor" stroke="none"></circle>
		<path d="M3 16l5-5 4 4 3-3 6 6"></path>
	</svg>
}

templ ChatPage(session db.Session, messages []DisplayMessage, needsReply bool, coverImage string, bgOptions []BackgroundOption, info SessionInfo) {
	@Layout(session.Title, "Chat") {
		<div
			if session.BackgroundImagePath != "" {
				style={ fmt.Sprintf("background-image:url(/static/%s);background-size:cover;background-position:center;background-attachment:fixed;", session.BackgroundImagePath) }
			}
			class="chat-page-bg"
		>
			@BackLink("/chat", "Chat")
			<div class="chat-header">
				<img class="chat-cover" src={ coverImage } alt=""/>
				<h1>{ session.Title }</h1>
				<button type="button" class="session-panel-toggle" aria-label="Session info" onclick="document.getElementById('session-panel').classList.toggle('open')">☰</button>
			</div>
			<div id="messages">
				if len(messages) == 0 {
					<p><em>No messages yet — say something below to start.</em></p>
				}
				for _, m := range messages {
					@MessageBlock(session.ID, m)
				}
			</div>
			if needsReply {
				<div
					id="live"
					hx-ext="sse"
					sse-connect={ fmt.Sprintf("/chat/%d/stream", session.ID) }
					sse-swap="message"
					hx-swap="beforeend"
				></div>
			}
			<div class="chat-input-toolbar">
				<button type="button" class="icon-button" disabled title="Not built yet">
					@imageIcon()
					Generate image
				</button>
			</div>
			<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages", session.ID)) } class="chat-input-row">
				<input type="text" name="content" placeholder="Say something..." autocomplete="off" required="required"/>
				<button type="submit" class="send-button" aria-label="Send">
					@sendIcon()
				</button>
			</form>
		</div>
		@sessionPanel(session, bgOptions, info)
		<script>
			// Land on the bottom of the conversation on load, and keep
			// following it as tokens stream in / the final styled swap
			// lands — otherwise every full-page POST-then-redirect from
			// hitting Enter resets scroll to the top of a (possibly
			// long) session, and typed replies grow past the fold
			// without the view following them.
			(function () {
				function scrollChatToBottom() {
					window.scrollTo(0, document.body.scrollHeight);
				}
				document.addEventListener("DOMContentLoaded", scrollChatToBottom);
				document.body.addEventListener("htmx:afterSwap", scrollChatToBottom);
				document.body.addEventListener("htmx:oobAfterSwap", scrollChatToBottom);
			})();

			// Edit toggles a hidden <form> per message rather than
			// navigating anywhere — cheaper than a modal for a single
			// textarea, and keeps Save a plain form POST (no JS needed
			// for the actual edit, only for revealing it). The button
			// lives inside this message's own "⋮" dropdown, so the
			// form to toggle is always the sibling found by walking up
			// to .message — no id/lookup needed.
			function toggleEditForm(button) {
				var message = button.closest(".message");
				var form = message.querySelector(".message-edit-form");
				form.style.display = form.style.display === "none" ? "block" : "none";
				closeOptionsMenu(button);
			}

			// Copy reads the message's own raw content back out of its
			// data-content attribute — never re-serializes it into a JS
			// string literal, so there's no quoting/escaping to get
			// wrong for apostrophes, backslashes, or newlines.
			function copyMessageContent(button) {
				var message = button.closest(".message");
				navigator.clipboard.writeText(message.dataset.content);
				closeOptionsMenu(button);
			}

			// Both actions above run without leaving the page, unlike
			// Regenerate/Branch/Delete (plain form POSTs that navigate
			// away), so their "⋮" dropdown would otherwise stay open
			// after the click — this closes whichever one the button
			// lives in.
			function closeOptionsMenu(button) {
				var dropdown = button.closest(".options-dropdown");
				if (dropdown) {
					dropdown.hidden = true;
				}
			}
		</script>
	}
}

// sessionPanel is the collapsible right-hand card with this session's
// own info — opened via the chat-header's "☰" button (plain CSS
// :not/.open toggle, no htmx needed for a client-only show/hide).
// Tabs reuse Settings' exact [hidden]+aria-selected pattern (see
// switchPanelTab below, a copy of settings.templ's switchSettingsTab —
// each page owns its own script in this codebase, nothing shared
// globally, so duplicating ~8 lines beats inventing a shared-script
// mechanism for one function).
templ sessionPanel(session db.Session, bgOptions []BackgroundOption, info SessionInfo) {
	<aside id="session-panel" class="session-panel">
		<div class="session-panel-header">
			<strong>Session</strong>
			<button type="button" aria-label="Close" onclick="document.getElementById('session-panel').classList.remove('open')">×</button>
		</div>
		<div class="tabs">
			<div role="tablist" class="tab-list">
				<button type="button" class="tab-btn" data-tab-target="summary" aria-selected="true" onclick="switchPanelTab(this)">Summary</button>
				<button type="button" class="tab-btn" data-tab-target="characters" aria-selected="false" onclick="switchPanelTab(this)">Characters</button>
				<button type="button" class="tab-btn" data-tab-target="world" aria-selected="false" onclick="switchPanelTab(this)">World</button>
				<button type="button" class="tab-btn" data-tab-target="persona" aria-selected="false" onclick="switchPanelTab(this)">Persona</button>
				<button type="button" class="tab-btn" data-tab-target="gallery" aria-selected="false" onclick="switchPanelTab(this)">Gallery</button>
				<button type="button" class="tab-btn" data-tab-target="background" aria-selected="false" onclick="switchPanelTab(this)">Background</button>
			</div>
			<div data-tab-panel="summary">
				<dl class="session-summary">
					<dt>Backend profile</dt>
					<dd>
						if info.BackendProfileName != "" {
							{ info.BackendProfileName }
						} else {
							<em>none</em>
						}
					</dd>
					<dt>Persona</dt>
					<dd>{ info.Persona.Name }</dd>
					<dt>World</dt>
					<dd>
						if info.LorebookName != "" {
							{ info.LorebookName }
						} else {
							<em>none attached</em>
						}
					</dd>
					<dt>Characters</dt>
					<dd>
						if len(info.Characters) == 0 {
							<em>none — freeform narrator</em>
						} else {
							{ fmt.Sprintf("%d attached", len(info.Characters)) }
						}
					</dd>
				</dl>
			</div>
			<div data-tab-panel="characters" hidden="hidden">
				if len(info.Characters) == 0 {
					<p><em>No characters attached — the narrator improvises freely.</em></p>
				} else {
					<ul class="panel-list">
						for _, c := range info.Characters {
							<li>
								@Avatar(c.ImagePath, c.Name)
								<a href={ templ.URL(fmt.Sprintf("/characters/%d/edit", c.ID)) }>{ c.Name }</a>
							</li>
						}
					</ul>
				}
			</div>
			<div data-tab-panel="world" hidden="hidden">
				if info.LorebookName == "" {
					<p><em>No lorebook attached to this session.</em></p>
				} else {
					<p><a href={ templ.URL(fmt.Sprintf("/world/%d", session.LorebookID)) }>{ info.LorebookName }</a></p>
					if len(info.ActiveLorebookEntries) == 0 {
						<p><em>No active entries (all disabled, or the book is empty).</em></p>
					} else {
						<p><small>Active entries — on in World, independent of whether this conversation has actually triggered them yet.</small></p>
						<ul class="panel-list">
							for _, e := range info.ActiveLorebookEntries {
								<li>{ strings.Join(e.Keys, ", ") }</li>
							}
						</ul>
					}
				}
			</div>
			<div data-tab-panel="persona" hidden="hidden">
				<p><strong>{ info.Persona.Name }</strong></p>
				if info.Persona.Description != "" {
					<p>{ info.Persona.Description }</p>
				} else {
					<p><em>No description set.</em></p>
				}
			</div>
			<div data-tab-panel="gallery" hidden="hidden">
				<p><em>Image generation isn't built yet (see the disabled "Generate image" button) — once it is, this tab will hold this session's generated images with a PNG download on each.</em></p>
			</div>
			<div data-tab-panel="background" hidden="hidden">
				if len(bgOptions) == 0 {
					<p><em>No lorebook/character images available on this session yet.</em></p>
				} else {
					<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/background", session.ID)) }>
						<select name="background_image_path">
							<option value="" selected?={ session.BackgroundImagePath == "" }>(none — default theme)</option>
							for _, opt := range bgOptions {
								<option value={ opt.Path } selected?={ session.BackgroundImagePath == opt.Path }>{ opt.Label }</option>
							}
						</select>
						<button type="submit">Apply</button>
					</form>
				}
			</div>
		</div>
		<script>
			function switchPanelTab(button) {
				var target = button.dataset.tabTarget;
				button.parentElement.querySelectorAll(".tab-btn").forEach(function (btn) {
					btn.setAttribute("aria-selected", String(btn === button));
				});
				button.closest(".tabs").querySelectorAll("[data-tab-panel]").forEach(function (panel) {
					panel.hidden = panel.dataset.tabPanel !== target;
				});
			}
		</script>
	</aside>
}
