package web

import (
	"fmt"
	"strings"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
	"github.com/Lord-ZuzurNC/AIvalon/internal/i18n"
)

// MessageBlock renders one chat line plus its per-message actions in a
// "⋮" dropdown, top-right — consistent with the same pattern used for
// Chat/World/Character/Settings rows. It's used both from ChatPage's
// history loop and from the Stream handler's final SSE out-of-band swap
// (see handlers_chat.go) — that second use is why this is its own templ
// component and not inlined: a reply you just watched stream in needs
// the same Regenerate/Branch/Delete/Copy options as one loaded from
// history, without a page reload.
templ MessageBlock(sessionID int64, m DisplayMessage) {
	<div class={ "message", "message-" + m.Role } data-content={ m.Content }>
		<div class="message-header">
			if m.ImagePath != "" {
				<figure class="message-image-figure">
					<a href={ templ.URL(imageSrc(m.ImagePath)) } target="_blank" rel="noopener">
						<img src={ imageSrc(m.ImagePath) } alt={ m.Content } loading="lazy"/>
					</a>
					<figcaption><small>{ m.Content }</small></figcaption>
				</figure>
			} else {
				<p>
					if m.Speaker != "" {
						<strong>{ m.Speaker }:</strong>{ " " }
					}
					@templ.Raw(m.ContentHTML)
				</p>
			}
			<div class="options-menu">
				<button type="button" class="options-trigger" aria-label={ i18n.T(ctx, "chat.message_options") } aria-haspopup="true" aria-expanded="false" aria-controls={ fmt.Sprintf("options-message-%d", m.ID) } data-menu-id={ fmt.Sprintf("options-message-%d", m.ID) } onclick="toggleOptionsMenu(this.dataset.menuId)">⋮</button>
				<div id={ fmt.Sprintf("options-message-%d", m.ID) } class="options-dropdown" role="menu" hidden>
					if m.Role == "user" {
						<button type="button" role="menuitem" onclick="toggleEditForm(this)">{ i18n.T(ctx, "common.action_edit") }</button>
					} else {
						if m.Role != "image" {
							<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/regenerate", sessionID, m.ID)) }>
								<button type="submit" role="menuitem">{ i18n.T(ctx, "chat.action_regenerate") }</button>
							</form>
						}
						<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/branch", sessionID, m.ID)) }>
							<button type="submit" role="menuitem">{ i18n.T(ctx, "chat.action_branch") }</button>
						</form>
					}
					<button type="button" role="menuitem" onclick="copyMessageContent(this)">{ i18n.T(ctx, "chat.action_copy") }</button>
					<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/delete", sessionID, m.ID)) }>
						<button type="submit" class="danger" role="menuitem">{ i18n.T(ctx, "common.action_delete") }</button>
					</form>
				</div>
			</div>
		</div>
		if m.Role == "user" {
			<form class="message-edit-form" style="display:none" method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages/%d/edit", sessionID, m.ID)) }>
				<textarea name="content" rows="3">{ m.Content }</textarea>
				<button type="submit">{ i18n.T(ctx, "chat.save_regenerate") }</button>
			</form>
		}
	</div>
}

templ ChatListPage(sessions []db.Session, pager Pager, profiles []db.BackendProfile, personas []db.Persona, characters []db.CharacterCard, lorebooks []db.Lorebook, presets []db.ImagePreset) {
	@Layout(i18n.T(ctx, "chat.title"), "chats") {
		if len(profiles) == 0 {
			<div class="page-header">
				<h1>{ i18n.T(ctx, "chat.title") }</h1>
			</div>
		} else {
			@PageHeaderWithCreate(i18n.T(ctx, "chat.title"), "session-modal", i18n.T(ctx, "chat.new_session"))
		}
		if len(sessions) == 0 {
			<p><em>{ i18n.T(ctx, "chat.empty_sessions") }</em></p>
		} else {
			@searchFilterInput("chat")
			<ul class="list-with-actions" data-search-scope="chat">
				for _, s := range sessions {
					<li data-search-name={ s.Title }>
						<a href={ templ.URL(fmt.Sprintf("/chat/%d", s.ID)) }>{ s.Title }</a>
						@OptionsMenu(fmt.Sprintf("options-chat-%d", s.ID), []MenuAction{
							{Label: i18n.T(ctx, "chat.action_duplicate"), Action: fmt.Sprintf("/chat/%d/duplicate", s.ID)},
							{Label: i18n.T(ctx, "chat.hide_into_vault"), Action: fmt.Sprintf("/vault/chats/%d/in", s.ID)},
							{Label: i18n.T(ctx, "common.action_delete"), Action: fmt.Sprintf("/chat/%d/delete", s.ID), Danger: true},
						})
					</li>
				}
			</ul>
			@pagerNav(pager)
			@searchFilterScript()
		}
		if len(profiles) == 0 {
			@templ.Raw(i18n.T(ctx, "chat.no_backend_html"))
		} else {
			@sessionModal(profiles, personas, characters, lorebooks, presets, false)
		}
	}
}

// sessionModal is the "New session" dialog — Chat's own, and the
// Vault's Chats-tab "+" (vaulted: posts vault=1 and is handed BOTH
// vaulted and plain characters/lorebooks; the vaulted ones carry a
// vault marker — the only place the two kinds are ever listed side
// by side, so two same-named items stay distinguishable).
templ sessionModal(profiles []db.BackendProfile, personas []db.Persona, characters []db.CharacterCard, lorebooks []db.Lorebook, presets []db.ImagePreset, vaulted bool) {
	<dialog id="session-modal">
		<article>
			<header>
				<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
				<strong>
					if vaulted {
						{ i18n.T(ctx, "chat.new_session_hidden") }
					} else {
						{ i18n.T(ctx, "chat.new_session") }
					}
				</strong>
			</header>
			<form method="post" action="/chat">
				if vaulted {
					<input type="hidden" name="vault" value="1"/>
				}
				<label>
					{ i18n.T(ctx, "chat.field_title") }
					<input type="text" name="title" placeholder={ i18n.T(ctx, "chat.title_placeholder") } value=""/>
				</label>
				<label>
					{ i18n.T(ctx, "chat.field_backend_profile") }
					<select name="backend_profile_id">
						for _, p := range profiles {
							<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
						}
					</select>
				</label>
				<label>
					{ i18n.T(ctx, "chat.field_persona_optional") }
					<select name="persona_id">
						<option value="">{ i18n.T(ctx, "chat.persona_default_option") }</option>
						for _, p := range personas {
							<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
						}
					</select>
				</label>
				if len(presets) > 0 {
					<label>
						{ i18n.T(ctx, "chat.field_image_preset_optional") }
						<select name="image_preset_id">
							<option value="0">{ i18n.T(ctx, "chat.image_preset_none_option") }</option>
							for _, p := range presets {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
							}
						</select>
						<small>{ i18n.T(ctx, "chat.image_preset_help") }</small>
					</label>
				}
				<fieldset>
					<legend>{ i18n.T(ctx, "chat.characters_legend") }</legend>
					@characterPickerStrip(characters, "character_ids")
				</fieldset>
				<label>
					{ i18n.T(ctx, "chat.lorebook_field_label") }
					<select name="lorebook_id">
						<option value="">{ i18n.T(ctx, "chat.lorebook_none_option") }</option>
						for _, l := range lorebooks {
							if l.IsVaulted {
								// An <option> can only hold text, so the
								// vault marker here is the padlock glyph,
								// not vaultMarker's SVG.
								<option value={ fmt.Sprintf("%d", l.ID) }>{ fmt.Sprintf(i18n.T(ctx, "chat.lorebook_vault_suffix"), l.Name) }</option>
							} else {
								<option value={ fmt.Sprintf("%d", l.ID) }>{ l.Name }</option>
							}
						}
					</select>
				</label>
				<button type="submit">{ i18n.T(ctx, "chat.start_chat") }</button>
			</form>
		</article>
	</dialog>
}

// characterPickerStrip is the New-session modal's character picker: a
// horizontally scrolling row of vignettes, each a toggle <button>
// (aria-pressed) rather than a link. The form still submits a plain
// name=character_ids list via one hidden checkbox per card (the
// button's next sibling — an <input> inside a <button> is invalid), so
// Create's r.Form["character_ids"] parsing is unchanged. Submission
// order is DOM order, same as the old <select multiple>, so "first
// character speaks first" still means the leftmost picked card.
templ characterPickerStrip(characters []db.CharacterCard, name string) {
	if len(characters) == 0 {
		@templ.Raw(i18n.T(ctx, "chat.characters_picker_empty_html"))
	} else {
		<div class="character-picker">
			for _, c := range characters {
				<button type="button" class="vignette-card character-pick" aria-pressed="false" title={ c.Name } onclick="toggleCharacterPick(this)">
					@vignetteFace(c.ImagePath, c.Name)
					if c.IsVaulted {
						@vaultMarker()
					}
				</button>
				<input type="checkbox" name={ name } value={ fmt.Sprintf("%d", c.ID) } hidden/>
			}
		</div>
		<script>
			function toggleCharacterPick(button) {
				var on = button.getAttribute("aria-pressed") !== "true";
				button.setAttribute("aria-pressed", on ? "true" : "false");
				button.nextElementSibling.checked = on;
			}
		</script>
	}
}

// RunawayRepetitionNotice is the out-of-band SSE payload streamWorldReply
// sends when it auto-stopped a generation that started repeating the
// same short phrase back-to-back (repeatedTailRun) — almost always a
// sign the context overflowed/got corrupted upstream. Same swap target
// as ContextTrimNotice so whichever fires last is what's shown.
templ RunawayRepetitionNotice() {
	<div id="context-trim-notice" hx-swap-oob="innerHTML">
		<small class="danger-text">{ i18n.T(ctx, "chat.runaway_notice") }</small>
	</div>
}

// ContextTrimNotice is the out-of-band SSE payload Stream sends when
// truncateHistoryToBudget left messages out of this reply's prompt, or
// when even dropping everything but the live turn didn't fit (the
// system prompt — persona/characters/lorebook — is big enough alone
// to exceed the budget; that part is never cut, see
// truncateHistoryToBudget's doc comment). The second case is the loud
// warning Lord asked for: silently sending an oversized prompt lets
// the LLM backend's own context-shift handling corrupt the exchange,
// which is how a huge lore card turns into an endless "World: World:
// World:" repetition loop that only stops when the backend is killed.
// innerHTML (not a full replace) so #context-trim-notice stays the
// same live-region node and screen readers announce the new text.
templ ContextTrimNotice(dropped int, stillOverBudget bool) {
	<div id="context-trim-notice" hx-swap-oob="innerHTML">
		if stillOverBudget {
			@templ.Raw(fmt.Sprintf(i18n.T(ctx, "chat.context_trim_over_budget"), dropped))
		} else {
			<small>{ trimNoticeText(ctx, dropped) } <a href="/settings">{ i18n.T(ctx, "chat.adjust_in_settings") }</a>{ " " + i18n.T(ctx, "chat.if_needed") }</small>
		}
	</div>
}

// sendIcon/imageIcon are small authored line-art SVGs (same
// stroke="currentColor" convention as navIcon in templates.templ) for
// the two input-row actions — a paper plane for Send, a simple framed
// landscape for Generate image. Neither is a vendored icon font or
// emoji.
templ sendIcon() {
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<path d="M3 11l18-8-8 18-2.5-7.5L3 11z"></path>
	</svg>
}

// generateImageButton is its own component (not inlined in ChatPage)
// so the Stream handler's final SSE swap can re-emit the EXACT same
// markup to flip it from disabled to enabled — one definition, no
// risk of the two drifting apart. hx-swap-oob="true" is harmless on
// a normal page load (nothing is doing an htmx swap then); it only
// matters when this exact markup rides inside an SSE payload, where
// htmx's SSE extension finds the existing #generate-image-btn and
// replaces it in place.
templ generateImageButton(enabled bool) {
	<button
		type="button"
		id="generate-image-btn"
		class="icon-button"
		data-modal-id="image-modal"
		disabled?={ !enabled }
		hx-swap-oob="true"
		onclick="document.getElementById(this.dataset.modalId).setAttribute('open','')"
	>
		@imageIcon()
		{ i18n.T(ctx, "chat.generate_image") }
	</button>
}

// hasLLMReply reports whether this session has had at least one
// actual LLM-generated reply (role "character" or "narrator") — the
// gate for enabling generateImageButton. Lord's call: letting someone
// generate an image before the narrator/character has said anything
// risks an image with zero scene context to draw from.
func hasLLMReply(messages []DisplayMessage) bool {
	for _, m := range messages {
		if m.Role == "character" || m.Role == "narrator" {
			return true
		}
	}
	return false
}

templ imageIcon() {
	<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<circle cx="9" cy="10" r="1.6" fill="currentColor" stroke="none"></circle>
		<path d="M3 16l5-5 4 4 3-3 6 6"></path>
	</svg>
}

templ ChatPage(session db.Session, messages []DisplayMessage, needsReply bool, coverImage string, bgOptions []BackgroundOption, info SessionInfo, imageForm ImageGenForm) {
	@Layout(session.Title, "chats") {
		<div
			if session.BackgroundImagePath != "" {
				style={ fmt.Sprintf("background-image:url(/static/%s);background-size:cover;background-position:center;background-attachment:fixed;", session.BackgroundImagePath) }
			}
			class={ "chat-page-bg", templ.KV("has-bg-image", session.BackgroundImagePath != "") }
		>
			<script>
				// Applied before #messages parses so a saved Bubble
				// layout doesn't flash as List first.
				if (localStorage.getItem("aivalon-chat-layout") === "bubble") {
					document.currentScript.parentElement.classList.add("chat-bubbles");
				}
			</script>
			if session.IsVaulted {
				@BackLink("/vault?tab=chats", i18n.T(ctx, "common.nav_vault"))
			} else {
				@BackLink("/chat", i18n.T(ctx, "chat.title"))
			}
			<div class="chat-header">
				<img class="chat-cover" src={ coverImage } alt=""/>
				<h1>{ session.Title }</h1>
				<button type="button" class="view-toggle-btn chat-layout-toggle" onclick="toggleChatLayout()" data-label-list={ i18n.T(ctx, "chat.layout_list") } data-label-bubble={ i18n.T(ctx, "chat.layout_bubble") } aria-label={ i18n.T(ctx, "chat.layout_list") } title={ i18n.T(ctx, "chat.layout_list") }>☰</button>
				<button type="button" class="session-panel-toggle" aria-label={ i18n.T(ctx, "chat.session_info") } onclick="document.getElementById('session-panel').classList.toggle('open')">☰</button>
			</div>
			<div class="chat-messages-wrap">
				<div id="messages">
					if len(messages) == 0 {
						<p><em>{ i18n.T(ctx, "chat.no_messages_yet") }</em></p>
					}
					for _, m := range messages {
						@MessageBlock(session.ID, m)
					}
				</div>
				if needsReply {
					<div
						id="live"
						hx-ext="sse"
						sse-connect={ fmt.Sprintf("/chat/%d/stream", session.ID) }
						sse-swap="message"
						hx-swap="beforeend"
					></div>
				}
			</div>
			<!-- Filled by an out-of-band SSE swap (ContextTrimNotice) when
			     this reply's prompt had to leave old messages out. -->
			<div id="context-trim-notice" class="context-trim-notice" role="status" aria-live="polite"></div>
			<div class="chat-input-toolbar">
				@generateImageButton(hasLLMReply(messages) && !DemoMode)
			</div>
			@imageGenModal(session.ID, imageForm, imageForm.activePreset(session.ImagePresetID))
			<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages", session.ID)) } class="chat-input-row">
				<input type="text" name="content" placeholder={ i18n.T(ctx, "chat.say_something_placeholder") } autocomplete="off" required="required"/>
				<button type="submit" class="send-button" aria-label={ i18n.T(ctx, "chat.send") }>
					@sendIcon()
				</button>
			</form>
		</div>
		@sessionPanel(session, bgOptions, info, messages, imageForm.Presets)
		<script>
			// Land on the bottom of the conversation on load, and keep
			// following it as tokens stream in / the final styled swap
			// lands — otherwise every full-page POST-then-redirect from
			// hitting Enter resets scroll to the top of a (possibly
			// long) session, and typed replies grow past the fold
			// without the view following them.
			(function () {
				function scrollChatToBottom() {
					window.scrollTo(0, document.body.scrollHeight);
				}
				document.addEventListener("DOMContentLoaded", scrollChatToBottom);
				document.body.addEventListener("htmx:afterSwap", scrollChatToBottom);
				document.body.addEventListener("htmx:oobAfterSwap", scrollChatToBottom);
			})();

			// Edit toggles a hidden <form> per message rather than
			// navigating anywhere — cheaper than a modal for a single
			// textarea, and keeps Save a plain form POST (no JS needed
			// for the actual edit, only for revealing it). The button
			// lives inside this message's own "⋮" dropdown, so the
			// form to toggle is always the sibling found by walking up
			// to .message — no id/lookup needed.
			function toggleEditForm(button) {
				var message = button.closest(".message");
				var form = message.querySelector(".message-edit-form");
				form.style.display = form.style.display === "none" ? "block" : "none";
				// Lets a content-sized bubble widen to fit the textarea.
				message.classList.toggle("editing", form.style.display === "block");
				closeOptionsMenu(button);
				if (form.style.display === "block") {
					form.querySelector("textarea").focus();
				}
			}

			// Copy reads the message's own raw content back out of its
			// data-content attribute — never re-serializes it into a JS
			// string literal, so there's no quoting/escaping to get
			// wrong for apostrophes, backslashes, or newlines.
			// List/Bubble layout, remembered globally (not per session)
			// in localStorage. The button shows the CURRENT layout's
			// own glyph (☰/💬), same convention as viewToggle. 💬
			// (U+1F4AC SPEECH BALLOON) over 🗩 (U+1F5E9 LEFT SPEECH
			// BUBBLE) on purpose — Lord's bug report: 🗩 has no glyph
			// on stock Android (Pixel 8 Pro), renders as a tofu box.
			// 💬 is near-universally supported.
			function syncChatLayoutToggle() {
				var bubble = document.querySelector(".chat-page-bg").classList.contains("chat-bubbles");
				var btn = document.querySelector(".chat-layout-toggle");
				var label = bubble ? btn.dataset.labelBubble : btn.dataset.labelList;
				btn.textContent = bubble ? "💬" : "☰";
				btn.setAttribute("aria-label", label);
				btn.setAttribute("title", label);
			}
			function toggleChatLayout() {
				var bubble = document.querySelector(".chat-page-bg").classList.toggle("chat-bubbles");
				localStorage.setItem("aivalon-chat-layout", bubble ? "bubble" : "list");
				syncChatLayoutToggle();
			}
			syncChatLayoutToggle();

			function copyMessageContent(button) {
				var message = button.closest(".message");
				navigator.clipboard.writeText(message.dataset.content);
				closeOptionsMenu(button);
			}

			// Both actions above run without leaving the page, unlike
			// Regenerate/Branch/Delete (plain form POSTs that navigate
			// away), so their "⋮" dropdown would otherwise stay open
			// after the click — this closes whichever one the button
			// lives in.
			function closeOptionsMenu(button) {
				var dropdown = button.closest(".options-dropdown");
				if (dropdown) {
					// Shared helper (Layout) also resets aria-expanded.
					closeOptionsMenus();
					var trigger = document.querySelector('.options-trigger[data-menu-id="' + dropdown.id + '"]');
					if (trigger) {
						trigger.focus();
					}
				}
			}
		</script>
	}
}

// sessionPanel is the collapsible right-hand card with this session's
// own info — opened via the chat-header's "☰" button (plain CSS
// :not/.open toggle, no htmx needed for a client-only show/hide).
// Tabs reuse Settings' exact [hidden]+aria-selected pattern (see
// switchPanelTab below, a copy of settings.templ's switchSettingsTab —
// each page owns its own script in this codebase, nothing shared
// globally, so duplicating ~8 lines beats inventing a shared-script
// mechanism for one function).
templ sessionPanel(session db.Session, bgOptions []BackgroundOption, info SessionInfo, messages []DisplayMessage, presets []db.ImagePreset) {
	<aside id="session-panel" class="session-panel">
		<div class="session-panel-header">
			<strong>{ i18n.T(ctx, "chat.session_heading") }</strong>
			<button type="button" aria-label={ i18n.T(ctx, "common.close") } onclick="document.getElementById('session-panel').classList.remove('open')">×</button>
		</div>
		<div class="tabs">
			<div role="tablist" class="tab-list">
				<button type="button" role="tab" class="tab-btn" data-tab-target="summary" aria-selected="true" onclick="switchPanelTab(this)">{ i18n.T(ctx, "chat.panel_tab_summary") }</button>
				<button type="button" role="tab" class="tab-btn" data-tab-target="characters" aria-selected="false" onclick="switchPanelTab(this)">{ i18n.T(ctx, "character.title") }</button>
				<button type="button" role="tab" class="tab-btn" data-tab-target="world" aria-selected="false" onclick="switchPanelTab(this)">{ i18n.T(ctx, "world.title") }</button>
				<button type="button" role="tab" class="tab-btn" data-tab-target="persona" aria-selected="false" onclick="switchPanelTab(this)">{ i18n.T(ctx, "chat.panel_tab_persona") }</button>
				<button type="button" role="tab" class="tab-btn" data-tab-target="gallery" aria-selected="false" onclick="switchPanelTab(this)">{ i18n.T(ctx, "chat.panel_tab_gallery") }</button>
				<button type="button" role="tab" class="tab-btn" data-tab-target="background" aria-selected="false" onclick="switchPanelTab(this)">{ i18n.T(ctx, "chat.panel_tab_background") }</button>
			</div>
			<div data-tab-panel="summary">
				<dl class="session-summary">
					<dt>{ i18n.T(ctx, "chat.field_backend_profile") }</dt>
					<dd>
						if info.BackendProfileName != "" {
							{ info.BackendProfileName }
						} else {
							<em>{ i18n.T(ctx, "chat.summary_none") }</em>
						}
					</dd>
					<dt>{ i18n.T(ctx, "chat.panel_tab_persona") }</dt>
					<dd>{ info.Persona.Name }</dd>
					<dt>{ i18n.T(ctx, "world.title") }</dt>
					<dd>
						if info.LorebookName != "" {
							{ info.LorebookName }
						} else {
							<em>{ i18n.T(ctx, "chat.summary_none_attached") }</em>
						}
					</dd>
					<dt>{ i18n.T(ctx, "character.title") }</dt>
					<dd>
						if len(info.Characters) == 0 {
							<em>{ i18n.T(ctx, "chat.summary_freeform") }</em>
						} else {
							{ fmt.Sprintf(i18n.T(ctx, "chat.summary_attached_count"), len(info.Characters)) }
						}
					</dd>
				</dl>
			</div>
			<div data-tab-panel="characters" hidden="hidden">
				if len(info.Characters) == 0 {
					<p><em>{ i18n.T(ctx, "chat.panel_characters_empty") }</em></p>
				} else {
					<ul class="panel-list">
						for _, c := range info.Characters {
							<li>
								@Avatar(c.ImagePath, c.Name)
								<a href={ templ.URL(fmt.Sprintf("/characters/%d/edit", c.ID)) }>{ c.Name }</a>
							</li>
						}
					</ul>
				}
			</div>
			<div data-tab-panel="world" hidden="hidden">
				if info.LorebookName == "" {
					<p><em>{ i18n.T(ctx, "chat.panel_world_empty") }</em></p>
				} else {
					<p><a href={ templ.URL(fmt.Sprintf("/world/%d", session.LorebookID)) }>{ info.LorebookName }</a></p>
					if len(info.ActiveLorebookEntries) == 0 {
						<p><em>{ i18n.T(ctx, "chat.panel_world_no_active_entries") }</em></p>
					} else {
						<p><small>{ i18n.T(ctx, "chat.panel_world_active_entries_help") }</small></p>
						<ul class="panel-list">
							for _, e := range info.ActiveLorebookEntries {
								<li>{ strings.Join(e.Keys, ", ") }</li>
							}
						</ul>
					}
				}
			</div>
			<div data-tab-panel="persona" hidden="hidden">
				<p><strong>{ info.Persona.Name }</strong></p>
				if info.Persona.Description != "" {
					<p>{ info.Persona.Description }</p>
				} else {
					<p><em>{ i18n.T(ctx, "chat.panel_persona_no_description") }</em></p>
				}
			</div>
			<div data-tab-panel="gallery" hidden="hidden">
				<!-- Same plain POST+Apply+redirect form as the Background tab. -->
				<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/image-preset", session.ID)) }>
					<label>
						{ i18n.T(ctx, "chat.panel_image_preset_label") }
						<select name="image_preset_id">
							<option value="0" selected?={ session.ImagePresetID == 0 }>{ i18n.T(ctx, "chat.panel_default_option") }</option>
							for _, p := range presets {
								<option value={ fmt.Sprintf("%d", p.ID) } selected?={ session.ImagePresetID == p.ID }>{ p.Name }</option>
							}
						</select>
						<small>@templ.Raw(i18n.T(ctx, "chat.panel_image_preset_help_html"))</small>
					</label>
					<button type="submit">{ i18n.T(ctx, "chat.apply") }</button>
				</form>
				{{ hasImages := false }}
				<div class="image-gallery">
					for _, m := range messages {
						if m.ImagePath != "" {
							{{ hasImages = true }}
							<div class="image-gallery-item">
								<a href={ templ.URL(imageSrc(m.ImagePath)) } target="_blank" rel="noopener">
										<img src={ imageSrc(m.ImagePath) } alt={ m.Content } loading="lazy"/>
									</a>
									<a href={ templ.URL(imageSrc(m.ImagePath)) } download role="button" class="secondary">{ i18n.T(ctx, "chat.download") }</a>
							</div>
						}
					}
				</div>
				if !hasImages {
					<p><em>@templ.Raw(i18n.T(ctx, "chat.panel_gallery_empty_html"))</em></p>
				}
			</div>
			<div data-tab-panel="background" hidden="hidden">
				if len(bgOptions) == 0 {
					<p><em>{ i18n.T(ctx, "chat.panel_background_empty") }</em></p>
				} else {
					<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/background", session.ID)) }>
						<select name="background_image_path">
							<option value="" selected?={ session.BackgroundImagePath == "" }>{ i18n.T(ctx, "chat.panel_background_none_option") }</option>
							for _, opt := range bgOptions {
								<option value={ opt.Path } selected?={ session.BackgroundImagePath == opt.Path }>{ opt.Label }</option>
							}
						</select>
						<button type="submit">{ i18n.T(ctx, "chat.apply") }</button>
					</form>
				}
			</div>
		</div>
		<script>
			function switchPanelTab(button) {
				var target = button.dataset.tabTarget;
				button.parentElement.querySelectorAll(".tab-btn").forEach(function (btn) {
					btn.setAttribute("aria-selected", String(btn === button));
				});
				button.closest(".tabs").querySelectorAll("[data-tab-panel]").forEach(function (panel) {
					panel.hidden = panel.dataset.tabPanel !== target;
				});
			}
		</script>
	</aside>
}


// imageGenModal is the "Generate image" dialog — same <dialog>+<article>
// shape as session-modal. The form posts via htmx so the Generate button
// can show #image-spinner and stay disabled for the (long) request;
// errors land in #image-result, success HX-Redirects to the session.
// Only the prompt (and backend, if several) is asked here: everything
// else comes server-side from the session's chosen preset.
templ imageGenModal(sessionID int64, f ImageGenForm, preset db.ImagePreset) {
	<dialog id="image-modal">
		<article>
			<header>
				<button aria-label={ i18n.T(ctx, "common.close") } rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
				<strong>{ i18n.T(ctx, "chat.generate_image") }</strong>
			</header>
			if len(f.Profiles) == 0 {
				@templ.Raw(i18n.T(ctx, "chat.no_image_backend_html"))
			} else {
				<form
					method="post"
					action={ templ.URL(fmt.Sprintf("/chat/%d/images", sessionID)) }
					hx-post={ fmt.Sprintf("/chat/%d/images", sessionID) }
					hx-target="#image-result"
					hx-swap="innerHTML"
					hx-indicator="#image-spinner"
					hx-disabled-elt="find button[type='submit']"
				>
					if preset.BackendProfileID != 0 {
						<input type="hidden" name="backend_profile_id" value={ fmt.Sprintf("%d", preset.BackendProfileID) }/>
					} else if len(f.Profiles) == 1 {
						<input type="hidden" name="backend_profile_id" value={ fmt.Sprintf("%d", f.Profiles[0].ID) }/>
					} else {
						<label>
							{ i18n.T(ctx, "chat.image_backend_label") }
							<select name="backend_profile_id">
								for _, p := range f.Profiles {
									<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
								}
							</select>
							<small>{ i18n.T(ctx, "chat.image_backend_help") }</small>
						</label>
					}
					<label>
						{ i18n.T(ctx, "chat.prompt_label") }
						<div class="test-row">
							<button
								type="button"
								class="secondary"
								hx-post={ fmt.Sprintf("/chat/%d/images/suggest-prompt", sessionID) }
								hx-target="#image-prompt-field"
								hx-swap="outerHTML"
								hx-indicator="#suggest-spinner"
							>{ i18n.T(ctx, "chat.suggest_prompt") }</button>
							<span id="suggest-spinner" class="htmx-indicator">{ i18n.T(ctx, "chat.thinking") }</span>
						</div>
						@imagePromptSuggestion("", "")
						<small>{ i18n.T(ctx, "chat.prompt_help") }</small>
					</label>
					<p>
						<small>
							if preset.Name != "" {
								{ fmt.Sprintf(i18n.T(ctx, "chat.using_preset"), preset.Name) }
								if preset.BackendProfileID != 0 {
									{ " " + i18n.T(ctx, "chat.backend_locked_by_preset") }
								} else {
									.
								}
							} else {
								{ i18n.T(ctx, "chat.no_preset_chosen") }
							}
							{ " " }{ i18n.T(ctx, "chat.change_in_gallery_tab") }{ " " }
							<a href="/settings">{ i18n.T(ctx, "settings.title") }</a>.
						</small>
					</p>
					<div class="test-row">
						<button type="submit">{ i18n.T(ctx, "chat.generate") }</button>
						<span id="image-spinner" class="htmx-indicator">{ i18n.T(ctx, "chat.generating_takes_a_while") }</span>
					</div>
					<div id="image-result" role="status" aria-live="polite"></div>
				</form>
			}
		</article>
	</dialog>
}

// imagePromptSuggestion is the swappable fragment inside the prompt
// label — SuggestImagePrompt replaces it via htmx with either a filled
// textarea (ready to review/edit, never auto-submitted) or an error,
// without touching the rest of the dialog/form state.
templ imagePromptSuggestion(value, errMsg string) {
	<div id="image-prompt-field">
		if errMsg != "" {
			<p class="danger-text" role="alert">{ errMsg }</p>
		}
		<textarea name="prompt" rows="3" required="required">{ value }</textarea>
	</div>
}
