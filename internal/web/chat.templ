package web

import (
	"fmt"

	"github.com/Lord-ZuzurNC/AIvalon/internal/db"
)

templ ChatListPage(sessions []db.Session, profiles []db.BackendProfile, personas []db.Persona, characters []db.CharacterCard, lorebooks []db.Lorebook) {
	@Layout("Chat", "Chat") {
		<h1>Chat</h1>
		if len(sessions) == 0 {
			<p><em>No sessions yet — start one below.</em></p>
		} else {
			<ul class="list-with-actions">
				for _, s := range sessions {
					<li>
						<a href={ templ.URL(fmt.Sprintf("/chat/%d", s.ID)) }>{ s.Title }</a>
						<span class="row-actions">
							<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/delete", s.ID)) } style="display:inline">
								<button type="submit" class="danger">Delete</button>
							</form>
						</span>
					</li>
				}
			</ul>
		}
		if len(profiles) == 0 {
			<p>
				No backend profile yet —
				<a href="/settings">add one in Settings</a>
				first.
			</p>
		} else {
			<button type="button" onclick="document.getElementById('session-modal').setAttribute('open','')">New session</button>

			<dialog id="session-modal">
				<article>
					<header>
						<button aria-label="Close" rel="prev" onclick="this.closest('dialog').removeAttribute('open')"></button>
						<strong>New session</strong>
					</header>
					<form method="post" action="/chat">
						<label>
							Title
							<input type="text" name="title" placeholder="Untitled chat" value=""/>
						</label>
						<label>
							Backend profile
							<select name="backend_profile_id">
								for _, p := range profiles {
									<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
								}
							</select>
						</label>
						<label>
							Persona (optional — defaults to "User")
							<select name="persona_id">
								<option value="">(default)</option>
								for _, p := range personas {
									<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name }</option>
								}
							</select>
						</label>
						<label>
							Characters (optional, select multiple for a group chat)
							<select name="character_ids" multiple="multiple">
								for _, c := range characters {
									<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
								}
							</select>
						</label>
						<label>
							Lorebook (optional — world info available to the narrator)
							<select name="lorebook_id">
								<option value="">(none)</option>
								for _, l := range lorebooks {
									<option value={ fmt.Sprintf("%d", l.ID) }>{ l.Name }</option>
								}
							</select>
						</label>
						<button type="submit">Start chat</button>
					</form>
				</article>
			</dialog>
		}
	}
}

templ ChatPage(session db.Session, messages []DisplayMessage, needsReply bool, coverImage string) {
	@Layout(session.Title, "Chat") {
		@BackLink("/chat", "Chat")
		<div class="chat-header">
			<img class="chat-cover" src={ coverImage } alt=""/>
			<h1>{ session.Title }</h1>
		</div>
		<div id="messages">
			if len(messages) == 0 {
				<p><em>No messages yet — say something below to start.</em></p>
			}
			for _, m := range messages {
				<p><strong>{ m.Speaker }:</strong> @templ.Raw(m.ContentHTML)</p>
			}
		</div>
		if needsReply {
			<div
				id="live"
				hx-ext="sse"
				sse-connect={ fmt.Sprintf("/chat/%d/stream", session.ID) }
				sse-swap="message"
				hx-swap="beforeend"
			></div>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/chat/%d/messages", session.ID)) }>
			<input type="text" name="content" placeholder="Say something..." autocomplete="off" required="required"/>
			<button type="submit">Send</button>
		</form>
		<script>
			// Land on the bottom of the conversation on load, and keep
			// following it as tokens stream in / the final styled swap
			// lands — otherwise every full-page POST-then-redirect from
			// hitting Enter resets scroll to the top of a (possibly
			// long) session, and typed replies grow past the fold
			// without the view following them.
			(function () {
				function scrollChatToBottom() {
					window.scrollTo(0, document.body.scrollHeight);
				}
				document.addEventListener("DOMContentLoaded", scrollChatToBottom);
				document.body.addEventListener("htmx:afterSwap", scrollChatToBottom);
				document.body.addEventListener("htmx:oobAfterSwap", scrollChatToBottom);
			})();
		</script>
	}
}
