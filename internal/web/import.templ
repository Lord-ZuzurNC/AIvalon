package web

import (
	"fmt"

	"github.com/Lord-ZuzurNC/AIvalon/internal/i18n"
)

// ImportCrossConfirmPage is shown instead of a plain error when an
// upload parses cleanly as the *other* kind of JSON (a Character Card
// dropped into World's importer, or a bare lorebook dropped into
// Character's) — Lord's call: guess what they meant and offer to
// finish the import in the right place rather than just failing.
// token is the ImportCache key the resume form sends back; cancelHref
// just goes back to where they started, nothing is imported either
// way until a button is actually clicked.
templ ImportCrossConfirmPage(active, message, resumeAction, cancelHref, token string) {
	@Layout(i18n.T(ctx, "import.title"), active) {
		<h1>{ i18n.T(ctx, "import.wrong_importer_heading") }</h1>
		<p>{ message }</p>
		<div class="import-confirm-actions">
			<form method="post" action={ templ.URL(resumeAction) }>
				<input type="hidden" name="token" value={ token }/>
				<button type="submit">{ i18n.T(ctx, "import.yes") }</button>
			</form>
			<button type="button" class="secondary" data-cancel-href={ cancelHref } onclick="location.href=this.dataset.cancelHref">{ i18n.T(ctx, "import.no") }</button>
		</div>
	}
}

// ImportLanguageConfirmPage is shown, before anything is created, when
// the uploaded card/lorebook's own text was confidently detected (see
// internal/langdetect) as a language other than AppSettings.Language
// — Lord's own ask (task t_424b1a52 → t_382b94fb): warn, then let the
// user choose. detectedName/targetName are plain display names, never
// a hardcoded per-language sentence — see languageDisplayName in
// handlers_import.go, which prefers internal/i18n's own
// Language.Name (what the nav switcher already shows) and only falls
// back to whatlanggo's own English name for a language this install
// ships no UI translation file for at all.
//
// Confirm re-POSTs token to resumeAction, which performs the actual
// double import (VO + translated copy, with its own fallback if no
// translation backend is reachable — see ImportLanguageResultPage).
// Cancel (cancelHref) creates nothing at all, same contract as
// ImportCrossConfirmPage's "No".
//
// Shape: <dialog open><article> — same convention as every other
// modal in this app (see templates.templ's DeleteConfirmPage) rather
// than a bare h1/p/div full-width page, which is what this page
// actually was before task t_166318f0/A (Lord's complaint: it reads
// as a blank navigated-to page, not a modal). Still a real HTTP
// response/page load under the hood — this app has no SPA route to
// avoid one (see languageSwitcher's own doc comment) — the <dialog>
// wrapper is purely the established *visual* modal convention here.
// The second, initially-hidden overlay (#import-loading-dialog) is
// task t_166318f0/C: the resumeAction POST can take 1-2 minutes
// (sequential per-field/per-entry translation calls, see
// translateCardFields/translateLorebookEntries in
// import_language.go) with otherwise zero visual feedback — Lord's
// own read of a real test session (veyra.png) was that the silent
// wait looked like a failed import. The confirm form's onsubmit
// closes this dialog and reveals the loading overlay; the browser
// then just sits on it until the server's response
// (ImportLanguageResultPage) replaces the whole document — no
// htmx/SSE needed for a plain POST that already navigates away.
//
// Task t_6fe4805d/2: that overlay used to be a real <dialog
// id="import-loading-dialog"> opened via showModal(), and Lord
// reported it could be dismissed early (backdrop click, Escape) —
// which matters a lot here since there is no way to resume or retry
// once dismissed; the user is just left looking at a page with no
// feedback while the POST is still running server-side. Reproduced
// both paths with chromium headless before touching anything:
// Escape closed it via the native `cancel` event's default action
// (fires on every open modal <dialog>, not just ones that opt into
// it); the backdrop click turned out to be Layout's own *global*
// `document.addEventListener("click", ...)` handler for the OTHER,
// non-modal dialogs on every page (the plain "Add …" ones toggled via
// setAttribute("open","")) — it matches on `e.target.tagName ===
// "DIALOG"`, which a backdrop click on ANY <dialog> (including a
// showModal() one) also satisfies, so it was removing this dialog's
// `open` attribute too, even though it was never meant to touch this
// one. Rather than special-case that shared handler (and have to
// re-remember the exception every time a new <dialog> is added to
// this app), this is now a plain `<div>` — by construction it has no
// `cancel` event, no backdrop semantics, and doesn't match
// `dialog[open]`/`tagName === "DIALOG"` in any of the shared
// dialog-management script, so there is no native or
// accidentally-shared close mechanism left to neutralize at all.
// Visually it's styled (see aivalon.css's #import-loading-dialog
// rules) to reproduce Pico's own `dialog`/`dialog > article` look
// exactly, so swapping the tag changes nothing the user can see.
templ ImportLanguageConfirmPage(active, detectedName, targetName, resumeAction, cancelHref, token string) {
	@Layout(i18n.T(ctx, "import.language_mismatch_title"), active) {
		<dialog
			open
			data-cancel-href={ cancelHref }
			onclick="if(event.target===this){location.href=this.dataset.cancelHref}"
		>
			<article>
				<header>
					<a href={ templ.URL(cancelHref) } aria-label={ i18n.T(ctx, "common.close") } rel="prev"></a>
					<strong>{ i18n.T(ctx, "import.language_mismatch_title") }</strong>
				</header>
				<p>{ i18n.T(ctx, "import.language_mismatch_warning", "detected", detectedName, "target", targetName) }</p>
				<!-- Cancel is a real <button> here, not <a role="button">
				     (task t_04e5ce3f): Lord measured a real, reproducible
				     20px height gap between this button and Confirm with
				     every CSS property (padding/line-height/font-size/
				     border/box-sizing) already identical per
				     getComputedStyle. Root cause, confirmed the same way
				     (chromium headless, getComputedStyle):
				     pico.classless.min.css gives native form controls
				     (button/[type=submit]) `appearance: button`, which
				     hands sizing over to the platform's native widget
				     engine — its line box doesn't follow the authored
				     line-height the way a plain, non-form `<a
				     role="button">` (`appearance: none`) does. Matching
				     CSS properties on two different HTML element kinds
				     is not guaranteed to matching boxes; making Cancel a
				     real <button> (same data-cancel-href + onclick as the
				     dialog's own backdrop-click handler above, since a
				     GET navigation needs no <form>) removes the
				     mismatched rendering path instead of chasing more
				     properties. Same fix applied to ImportCrossConfirmPage
				     and DeleteConfirmPage's Cancel buttons, the only other
				     places this <a role="button"> vs <button> pairing
				     existed. -->
				<footer class="import-confirm-actions">
					<button type="button" class="secondary" data-cancel-href={ cancelHref } onclick="location.href=this.dataset.cancelHref">{ i18n.T(ctx, "import.language_cancel") }</button>
					<form
						method="post"
						action={ templ.URL(resumeAction) }
						onsubmit="this.closest('dialog').close();document.getElementById('import-loading-dialog').classList.add('is-visible')"
					>
						<input type="hidden" name="token" value={ token }/>
						<button type="submit">{ i18n.T(ctx, "import.language_confirm") }</button>
					</form>
				</footer>
			</article>
		</dialog>
		<div id="import-loading-dialog">
			<article>
				<p>
					{ i18n.T(ctx, "import.language_translating") }
					<span class="loading-dots" aria-hidden="true"><span></span><span></span><span></span></span>
				</p>
			</article>
		</div>
	}
}

// ImportLanguageResultPage is the landing page after
// ImportLanguageConfirmPage's Confirm button — it always reports what
// actually happened rather than silently redirecting, because the
// fallback case (no translation backend reachable, or the call
// failed) has no other way to tell the user "the VF copy wasn't made"
// than a page they actually see. voOnly means the fallback triggered:
// only the original (VO) landed, warning names why, and vfName is
// irrelevant/unused. voOnly=false means both copies were created;
// warning stays empty on that full-success path.
//
// Same <dialog open><article> shape as ImportLanguageConfirmPage, for
// the same reason (task t_166318f0/A) — this page had the identical
// bare-page issue.
templ ImportLanguageResultPage(active, voName, vfName, warning string, voOnly bool, continueHref string) {
	@Layout(i18n.T(ctx, "import.language_result_title"), active) {
		<dialog
			open
			data-cancel-href={ continueHref }
			onclick="if(event.target===this){location.href=this.dataset.cancelHref}"
		>
			<article>
				<header>
					<a href={ templ.URL(continueHref) } aria-label={ i18n.T(ctx, "common.close") } rel="prev"></a>
					<strong>{ i18n.T(ctx, "import.language_result_title") }</strong>
				</header>
				if voOnly {
					<p>{ i18n.T(ctx, "import.language_result_vo_only", "name", voName) }</p>
					<p class="import-warning">{ warning }</p>
				} else {
					<p>{ i18n.T(ctx, "import.language_result_both", "vo", voName, "vf", vfName) }</p>
				}
				<footer>
					<a href={ templ.URL(continueHref) } role="button">{ i18n.T(ctx, "import.language_continue") }</a>
				</footer>
			</article>
		</dialog>
	}
}

// ImportBatchLanguageConfirmPage is the multi-file counterpart of
// ImportLanguageConfirmPage: one combined screen listing every file
// from the batch whose language-mismatch gate fired (pending), rather
// than confirming them one at a time — chosen over a sequential
// per-file flow because N round trips for N files is worse UX than
// one shared decision, and because the existing single-file
// infrastructure (ImportCache tokens) already supports stashing many
// independent files at once with zero changes (see docs/DESIGN.md's
// "Multi-file import" section for the full reasoning). alreadyDone
// lists files that imported immediately in the same request (no
// mismatch) — carried through as hidden fields purely so the FINAL
// report (after Confirm/Cancel) can still mention them; nothing here
// touches them again. "Confirm all" redeems every token through the
// same VO+VF pipeline a single file would use; "Cancel all" creates
// nothing for the pending files (their tokens simply expire unused).
templ ImportBatchLanguageConfirmPage(active string, pending []batchPendingItem, alreadyDone []string, errs []batchFileError, resumeAction, cancelHref string, vaulted bool) {
	@Layout(i18n.T(ctx, "import.language_mismatch_title"), active) {
		<h1>{ i18n.T(ctx, "import.batch_language_mismatch_title") }</h1>
		<p>{ i18n.T(ctx, "import.batch_language_mismatch_intro") }</p>
		<ul>
			for _, item := range pending {
				<li>{ i18n.T(ctx, "import.language_mismatch_warning", "detected", item.DetectedName, "target", item.TargetName) } — <strong>{ item.Label }</strong></li>
			}
		</ul>
		if len(alreadyDone) > 0 || len(errs) > 0 {
			<p class="import-batch-summary">{ i18n.T(ctx, "import.batch_other_files_note") }</p>
		}
		<form method="post" action={ templ.URL(resumeAction) }>
			if vaulted {
				<input type="hidden" name="vault" value="1"/>
			}
			for _, item := range pending {
				<input type="hidden" name="tokens" value={ item.Token }/>
			}
			for _, name := range alreadyDone {
				<input type="hidden" name="already_done" value={ name }/>
			}
			<div class="import-confirm-actions">
				<button type="submit" name="action" value="confirm">{ i18n.T(ctx, "import.batch_confirm_all") }</button>
				<button type="submit" name="action" value="cancel" class="secondary">{ i18n.T(ctx, "import.batch_cancel_all") }</button>
			</div>
		</form>
	}
}

// ImportBatchResultPage is the final report after a multi-file
// import — whether everything landed on the first pass (no
// mismatches at all) or after ImportBatchLanguageConfirmPage's
// Confirm/Cancel, this is the one page that names every outcome:
// what was created, and which files failed and why. Never silently
// drops a file's outcome (see docs/DESIGN.md).
templ ImportBatchResultPage(active string, successes []string, errs []batchFileError, continueHref string) {
	@Layout(i18n.T(ctx, "import.batch_result_title"), active) {
		<h1>{ i18n.T(ctx, "import.batch_result_title") }</h1>
		<p>{ i18n.T(ctx, "import.batch_result_summary", "ok", fmt.Sprint(len(successes)), "failed", fmt.Sprint(len(errs))) }</p>
		if len(successes) > 0 {
			<ul class="import-batch-successes">
				for _, name := range successes {
					<li>{ name }</li>
				}
			</ul>
		}
		if len(errs) > 0 {
			<ul class="import-batch-errors">
				for _, e := range errs {
					<li><strong>{ e.Filename }</strong>: { e.Reason }</li>
				}
			</ul>
		}
		<a href={ templ.URL(continueHref) } role="button">{ i18n.T(ctx, "import.language_continue") }</a>
	}
}
